{
  "name": "ntp-1",
  "image": "chrony",
  "cmd": [
    "/usr/sbin/chronyd",
    "-d",
    "-f",
    "/etc/chrony.conf"
  ],
  "capture_output": true,
  "networks": [
    {
      "name": "management",
      "ip": "192.168.15.105"
    }
  ],
  "restart": "always",
  "restart_delay_seconds": 2,
  "cap_add": [
    "CAP_SYS_TIME"
  ],
  "files": [
    {
      "path": "/etc/chrony.conf",
      "content": "local stratum 10\nallow 192.168.15.0/24\ndriftfile /run/chrony.drift\n"
    },
    {
      "path": "/etc/passwd",
      "content": "root:x:0:0:root:/root:/usr/bin/bash\n"
    },
    {
      "path": "/etc/group",
      "content": "root:x:0:\n"
    }
  ]
}
