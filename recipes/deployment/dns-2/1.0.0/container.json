{
  "name": "dns-2",
  "image": "dns",
  "cmd": [
    "/usr/sbin/dnsmasq",
    "-k",
    "-u",
    "root",
    "-p",
    "53",
    "-H",
    "/etc/dnsmasq-hosts",
    "-R",
    "-h",
    "--pid-file=",
    "--servers-file=/etc/dnsmasq-servers"
  ],
  "networks": [
    {
      "name": "management",
      "ip": "192.168.15.102"
    }
  ],
  "restart": "always",
  "files": [
    {
      "path": "/etc/dnsmasq-servers",
      "content": ""
    }
  ]
}
