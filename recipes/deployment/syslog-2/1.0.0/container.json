{
  "name": "syslog-2",
  "image": "syslog",
  "cmd": [
    "/usr/sbin/syslogd",
    "-F",
    "-K",
    "-n",
    "-H",
    "-P",
    "/run/syslogd.pid",
    "-C",
    "/run/syslogd.cache",
    "-f",
    "/etc/syslog.conf"
  ],
  "networks": [
    {
      "name": "management",
      "ip": "192.168.15.108"
    }
  ],
  "restart": "always",
  "files": [
    {
      "path": "/etc/syslog.conf",
      "content": "*.*\t\t\t\t\t-/var/log/messages\n"
    }
  ]
}
