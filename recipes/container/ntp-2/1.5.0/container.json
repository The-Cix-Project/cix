{
  "name": "ntp-2",
  "image": "chrony",
  "userns": false,
  "services": [
    {
      "name": "chronyd",
      "cmd": [
        "/usr/sbin/chronyd",
        "-d",
        "-f",
        "/etc/chrony.conf"
      ],
      "on_exit": "fail-container"
    }
  ],
  "consoles": [
    {
      "name": "chronyc",
      "cmd": [
        "/usr/bin/chronyc"
      ]
    }
  ],
  "capture_output": true,
  "networks": [
    {
      "name": "services",
      "ip": "192.168.150.106"
    }
  ],
  "restart": "always",
  "restart_delay_seconds": 2,
  "cap_add": [
    "CAP_SYS_TIME"
  ],
  "files": [
    {
      "path": "/etc/chrony.conf",
      "content": "local stratum 10\nallow 192.168.150.0/24\nallow 192.168.15.0/24\ndriftfile /run/chrony.drift\n"
    },
    {
      "path": "/etc/passwd",
      "content": "root:x:0:0:root:/root:/usr/bin/bash\n"
    },
    {
      "path": "/etc/group",
      "content": "root:x:0:\n"
    }
  ],
  "routes": [
    {
      "dest": "0.0.0.0",
      "prefix_len": 0,
      "via": "192.168.150.254"
    }
  ]
}
