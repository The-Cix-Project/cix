{
  "name": "syslog-1",
  "image": "syslog",
  "services": [
    {
      "name": "syslogd",
      "cmd": [
        "/usr/sbin/syslogd",
        "-F",
        "-K",
        "-n",
        "-H",
        "-P",
        "/run/syslogd.pid",
        "-C",
        "/run/syslogd.cache",
        "-f",
        "/etc/syslog.conf"
      ],
      "on_exit": "fail-container"
    }
  ],
  "networks": [
    {
      "name": "services",
      "ip": "192.168.150.107"
    }
  ],
  "restart": "always",
  "files": [
    {
      "path": "/etc/syslog.conf",
      "content": "*.*\t\t\t\t\t-/var/log/messages\n"
    }
  ],
  "routes": [
    {
      "dest": "0.0.0.0",
      "prefix_len": 0,
      "via": "192.168.150.254"
    }
  ]
}
