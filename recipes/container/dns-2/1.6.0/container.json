{
  "name": "dns-2",
  "image": "dns",
  "services": [
    {
      "name": "dnsmasq",
      "cmd": [
        "/usr/sbin/dnsmasq",
        "-k",
        "-u",
        "root",
        "-p",
        "53",
        "-H",
        "/etc/dnsmasq-hosts",
        "-R",
        "-h",
        "--pid-file=",
        "--servers-file=/etc/dnsmasq-servers"
      ]
    }
  ],
  "networks": [
    {
      "name": "services",
      "ip": "192.168.150.102"
    }
  ],
  "restart": "always",
  "files": [
    {
      "path": "/etc/dnsmasq-hosts",
      "content": ""
    },
    {
      "path": "/etc/dnsmasq-servers",
      "content": ""
    }
  ],
  "capture_output": true,
  "dns_server": {
    "hosts_path": "/etc/dnsmasq-hosts"
  },
  "routes": [
    {
      "dest": "0.0.0.0",
      "prefix_len": 0,
      "via": "192.168.150.254"
    }
  ]
}
