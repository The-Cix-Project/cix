# GNU tar. Converted from build.sh to build.cbs (ADR-0305 stage 4,
# #487).
#
# WHAT CHANGES:
#
#   usr/share    -- no longer deleted (ADR-0306, #491).
#   usr/libexec  -- still deleted. That is rmt, the remote-tape
#                   helper, and nothing here drives a tape over rsh.
#                   A package's own judgement about what it ships, not
#                   a documentation category.
#
# THE SELF-TEST IS THE POINT OF THIS RECIPE AND IT SURVIVES, but one
# of its three checks does not translate and that is worth stating
# plainly rather than leaving to a diff.
#
# It exists because of #122: upstream TCC 0.9.27 silently dropped the
# condition of a do-while whose body ends unreachably, which is
# exactly read_and()'s shape, so a TCC-built tar listed and extracted
# exactly ONE member per archive and exited 0 every time. Creation
# was always correct. The lesson recorded then was that a gate must
# compare CONTENT, because exit status was worthless here.
#
# The shell version did three things: create, list and grep the
# listing for three paths, then extract and sha256-compare each file
# against its original. The listing grep needs `tar -tf` redirected
# to a file, and CPDL cannot capture multi-line stdout at this
# version (cix-build-system#185) -- `run "tar" { "-tf" ... }` proves
# only exit 0, which is the precise thing #122 proved worthless.
#
# So the listing grep is gone and the content comparison stays, now
# as three `require file { same_as }`. That keeps the coverage: -t and
# -x are both read_and(), and a truncating tar cannot produce three
# byte-identical extracted files at three different depths. What is
# genuinely lost is a direct check of `tar -t`'s OUTPUT, which comes
# back when #185's `stdout file` lands.
package "tar" {
    version "1.35"
    release 7
    format "cixpkg"

    sources {
        main "tar" {
            url "https://ftp.gnu.org/gnu/tar/tar-1.35.tar.gz"
            sha256 "14d55e32063ea9526e057fbf35fcabd53378e769787eff7919c3755b02d2b57e"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
        }
    }

    metadata {
        "artifact_sha256" "091ead553adb7599353dd165b362d62ea06ae99b04f1b2f60a2d6ce7e15f202b"
        "changelog" "1.35-7: converted from build.sh to build.cbs (ADR-0305 stage 4) and published as a .cixpkg (ADR-0307). Same tarball at the same digest and the same configure line. Stops deleting usr/share (ADR-0306, #491); still drops usr/libexec, which is rmt. The #122 round-trip self-test survives as three require file same_as checks; its grep of tar -tf output is gone because CPDL cannot capture multi-line stdout yet (cbs#185), and exit status is the one thing #122 proved worthless."
    }

    build {
        cd "${src}/tar/tar-1.35" {
            run "./configure" {
                "--prefix=/usr"
                "MAKEINFO=true"
                env "CC" = "tcc"
                env "FORCE_UNSAFE_CONFIGURE" = "1"
            }
            run "make" {
                jobs $jobs
                "MAKEINFO=true"
            }
        }
    }

    check {
        # Three files at three depths, with different lengths, so a
        # truncating or mis-ordering tar cannot pass by accident.
        mkdir "${src}/tar/tar-1.35/selftest/probe/sub" chmod 0755
        write "${src}/tar/tar-1.35/selftest/probe/a.txt" "one"
        write "${src}/tar/tar-1.35/selftest/probe/b.txt" "twotwo"
        write "${src}/tar/tar-1.35/selftest/probe/sub/c.txt" "three"
        cd "${src}/tar/tar-1.35/selftest" {
            run "${src}/tar/tar-1.35/src/tar" {
                "-cf"
                "probe.tar"
                "probe"
            }
            # Exit status only. #122 is exactly why that is not
            # enough on its own, and why the comparisons below are
            # the real gate.
            run "${src}/tar/tar-1.35/src/tar" {
                "-tf"
                "probe.tar"
            }
        }
        mkdir "${src}/tar/tar-1.35/selftest/extract" chmod 0755
        cd "${src}/tar/tar-1.35/selftest/extract" {
            run "${src}/tar/tar-1.35/src/tar" {
                "-xf"
                "${src}/tar/tar-1.35/selftest/probe.tar"
            }
        }
        require file "${src}/tar/tar-1.35/selftest/extract/probe/a.txt" {
            exists
            same_as "${src}/tar/tar-1.35/selftest/probe/a.txt"
        }
        require file "${src}/tar/tar-1.35/selftest/extract/probe/b.txt" {
            exists
            same_as "${src}/tar/tar-1.35/selftest/probe/b.txt"
        }
        require file "${src}/tar/tar-1.35/selftest/extract/probe/sub/c.txt" {
            exists
            same_as "${src}/tar/tar-1.35/selftest/probe/sub/c.txt"
        }
    }

    install {
        cd "${src}/tar/tar-1.35" {
            run "make" {
                "install"
                "DESTDIR=${dest}"
                "MAKEINFO=true"
            }
        }
        remove tree "${dest}/usr/libexec"
        require file "${dest}/usr/bin/tar" {
            exists
            nonempty
        }
    }
}
