# gzip, as a PBS recipe (ADR-0305 stage 4).
#
# A translation of the previous build.sh: same tarball at the same
# digest, the same configure invocation, the same `make install`.
#
# The shell recipe deleted usr/share/{man,info}; ADR-0306 withdrew that practice (#491) and those lines are gone.
package "gzip" {
    version "1.13"
    release 5
    format "cixpkg"

    license "GPL-3.0-or-later"

    sources {
        main "gzip" {
            url "https://ftp.gnu.org/gnu/gzip/gzip-1.13.tar.xz"
            sha256 "7454eb6935db17c6655576c2e1b0fabefd38b4d0936e0f87f48cd062ce91a057"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
        }
    }

    metadata {
        "artifact_sha256" "519631f48097288b3d1d9704d19652d19374b95b1af94f16119acbaf64080743"
        "changelog" "1.13-5: converted from build.sh to build.cbs (ADR-0305 stage 4). Same tarball at the same digest and the same configure invocation. Stops deleting its own documentation (ADR-0306, #491)."
    }

    prepare {
        run "ls" {
            "-la"
            "${src}/gzip"
        }
        require directory "${src}/gzip/gzip-1.13" {
            exists
        }
    }

    build {
        cd "${src}/gzip/gzip-1.13" {
            run "./configure" {
                "--prefix=/usr"
                env "CC" = "tcc"
            }
            run "make" {
                "MAKEINFO=true"
                jobs $jobs
            }
        }
    }

    install {
        cd "${src}/gzip/gzip-1.13" {
            run "make" {
                "install"
                "DESTDIR=${dest}"
                "MAKEINFO=true"
            }
        }
        require file "${dest}/usr/bin/gzip" {
            exists
            nonempty
        }
    }
}
