# findutils -- find, xargs, locate, updatedb. Converted from build.sh
# to build.cbs (ADR-0305 stage 4, #487).
#
# WHAT CHANGES: usr/share/{man,info,locale} is no longer deleted
# (ADR-0306, #491) -- exactly the withdrawn categories and nothing
# else, so there is no package-specific judgement to preserve here.
#
# The TCC define carries over unchanged and is not optional:
# _GL_EXTERN_INLINE_STDHEADER_BUG=1 forces gnulib onto its own
# designed-in `static _GL_UNUSED` fallback. Without it TCC's C99
# inline gap makes gnulib emit globally-visible definitions of its
# helpers in every translation unit and the link fails with dozens of
# "defined twice" -- the same failure m4, sed, grep, coreutils and
# bison all document.
#
# No hard links: the installed 4.10.0-5 lists four distinct tools
# with no versioned or aliased twin, checked before writing rather
# than discovered in a failed build (cix-build-system#182).
package "findutils" {
    version "4.10.0"
    release 6
    format "cixpkg"

    sources {
        main "findutils" {
            url "https://ftp.gnu.org/gnu/findutils/findutils-4.10.0.tar.xz"
            sha256 "1387e0b67ff247d2abde998f90dfbf70c1491391a59ddfecb8ae698789f0a4f5"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
        }
    }

    metadata {
        "changelog" "4.10.0-6: converted from build.sh to build.cbs (ADR-0305 stage 4) and published as a .cixpkg (ADR-0307). Same tarball at the same digest and the same gnulib _GL_EXTERN_INLINE_STDHEADER_BUG define TCC needs. Stops deleting usr/share/{man,info,locale} (ADR-0306, #491), which are exactly the withdrawn categories."
    }

    build {
        cd "${src}/findutils/findutils-4.10.0" {
            run "./configure" {
                "--prefix=/usr"
                env "CC" = "tcc"
                env "CFLAGS" = "-D_GL_EXTERN_INLINE_STDHEADER_BUG=1"
            }
            run "make" {
                jobs $jobs
                "MAKEINFO=true"
            }
        }
    }

    install {
        cd "${src}/findutils/findutils-4.10.0" {
            run "make" {
                "install"
                "DESTDIR=${dest}"
                "MAKEINFO=true"
            }
        }
        require file "${dest}/usr/bin/find" {
            exists
            nonempty
        }
        require file "${dest}/usr/bin/xargs" {
            exists
            nonempty
        }
    }
}
