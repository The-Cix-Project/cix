# OpenSSH -- sshd and the client tools the jump box runs. Converted
# from build.sh to build.cbs (ADR-0305 stage 4, #487).
#
# WHAT CHANGES: usr/share/man is no longer deleted (ADR-0306, #491).
# That is the only removal this recipe made.
#
# CC=tcc explicitly, never a bare cc, and this package is the reason
# the rule exists. openssh's own -2 revision relied on the build
# sandbox's default compiler and got real GCC: link commands spelled
# `cc`, carrying GCC-family hardening flags TCC does not emit, and --
# despite configure reporting "PAM support: yes" and -lpam -lcrypt
# being present on the link line -- an sshd binary with neither
# library recorded as a real ELF DT_NEEDED (#109, ADR-0144).
package "openssh" {
    version "10.4p1"
    release 12
    format "cixpkg"

    sources {
        main "openssh" {
            url "https://cdn.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-10.4p1.tar.gz"
            sha256 "ef6026dd2aea8d56059638d5d3262902c892ceba9f88395835e0d06d3fb63238"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
            tool "findutils"
            tool "diffutils"
            tool "pkgconf"
            tool "openssl"
            tool "zlib"
            tool "linux-pam"
            tool "libxcrypt"
        }
        runtime {
            package "openssl"
            package "zlib"
            package "linux-pam"
            package "libxcrypt"
        }
    }

    metadata {
        "changelog" "10.4p1-12: converted from build.sh to build.cbs (ADR-0305 stage 4) and published as a .cixpkg (ADR-0307). Same tarball at the same digest and the same configure line, CC=tcc included -- which this package is the reason for, its -2 revision having silently built against real GCC and produced an sshd with neither libpam nor libcrypt recorded as a DT_NEEDED (#109). Stops deleting usr/share/man (ADR-0306, #491)."
    }

    build {
        cd "${src}/openssh/openssh-10.4p1" {
            run "./configure" {
                "--prefix=/usr"
                "--sysconfdir=/etc/ssh"
                "--with-privsep-path=/run/sshd-empty"
                "--with-privsep-user=sshd"
                "--with-pid-dir=/run"
                "--with-pam"
                env "CC" = "tcc"
            }
            run "make" {
                jobs $jobs
            }
        }
    }

    install {
        cd "${src}/openssh/openssh-10.4p1" {
            run "make" {
                "install"
                "DESTDIR=${dest}"
            }
        }
        require file "${dest}/usr/sbin/sshd" {
            exists
            nonempty
        }
        require file "${dest}/usr/bin/ssh" {
            exists
            nonempty
        }
    }
}
