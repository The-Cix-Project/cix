# v3 IS THE CONTROL, and 1-2 is not a result without it.
#
# 1-2 declared CAP_SYS_ADMIN and its build container reported
# CapEff=0x00000000b8a4fdff, in which bit 21 (CAP_SYS_ADMIN) is set.
# That alone proves nothing: bit 12 (CAP_NET_ADMIN) is set in the same
# mask and 1-2 never declared it, so "the bit is set" is consistent
# with the declaration having done nothing at all.
#
# This revision is byte-identical to 1-2 except that the `capability`
# declaration is removed. If bit 21 is CLEAR here, the declaration is
# what set it there. If it is set here too, then 1-2 proved only that
# the publish is accepted, and the grant is unverified.
#
# Written because the alternative was to report an inference as a
# measurement, which is the failure this project's own instructions
# name most often.
#
# probe-pbs-caps -- does cixd read a PBS recipe's capability NAMES and
# its metadata block? (cix-build-system#161 and #162, both closed)
#
# This recipe could not be PUBLISHED at all until cix v2.57.219. `cbs
# explain --json` reported a capability COUNT, and cixd refused any
# PBS recipe declaring one rather than building it without the
# capability -- a count of 1 does not say whether the recipe asked for
# CAP_SYS_ADMIN or CAP_NET_ADMIN, and granting by count would be worse
# than not supporting the field. So the publish succeeding is itself
# half the result.
#
# v2 fixes two things version 1 got wrong, both refused by CPDL and
# both worth recording because they are what a recipe author will hit:
#
#   CPDL-E3003  "package declaration appears out of order". CPDL fixes
#               the order of a package's declarations. v1 put metadata
#               and capability BEFORE sources. The order is
#               version, release, format, [license], [upstream],
#               sources, requires, metadata, capability, phases --
#               taken from upstream's own cli-contract-test.sh fixture
#               and kernel.cbs, not guessed.
#
#   CPDL-E3006  "command interpreters are not valid run executables".
#               CPDL REFUSES `run "bash"`. That is the language doing
#               its job: a declarative recipe that can shell out is a
#               shell recipe with extra syntax, and the whole point of
#               the flip is to stop writing those. v1 used
#               `bash -c` with shell arithmetic to test a capability
#               bit; there is no way to express that and there should
#               not be.
#
# So the capability mask is printed with grep and read out of the
# build log instead. CAP_SYS_ADMIN is capability 21, so bit 21 of the
# mask -- 0x200000. Printing every one of the four masks rather than
# only CapEff makes the answer diagnosable: a capability present in
# CapBnd but absent from CapEff is a different bug from one missing
# everywhere.
#
# EXPECTED RESULT: the install SUCCEEDS; the build log shows a CapEff
# with bit 21 set; and `GET /v1/pkg/recipes/probe-pbs-caps` reports
# the changelog below rather than null -- which is the metadata block
# being read, since CPDL has no `changelog` keyword of its own.
package "probe-pbs-caps" {
    version "1"
    release 3
    format "cixpkg"

    sources {
        main "cixsrc" {
            url "https://osakka:{{REPO_TOKEN}}@git.home.arpa/api/v1/repos/itdlabs/cix/archive/v2.57.219.tar.gz"
            sha256 "d4c2727bb495dfcf63f1b82157183794cf95957abca6c351baff6979d5949d0d"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "bash"
            tool "coreutils"
            tool "grep"
        }
    }

    metadata {
        "changelog" "1-3: the CONTROL for 1-2 -- identical but declaring NO capability, so the difference in CapEff is attributable to the declaration. Proves cixd reads capability NAMES and the metadata block (cix-build-system#161, #162). Publishable at all only from cix v2.57.219. v1 was refused twice by CPDL: metadata and capability declared before sources (E3003), and run bash (E3006 -- interpreters are not valid run executables, by design)."
    }

    build {
        # All four masks, so a capability present in CapBnd but absent
        # from CapEff reads as a different answer from one missing
        # everywhere. grep directly: CPDL has no interpreter to invoke
        # and needs none for this.
        run "grep" {
            "-E"
            "^Cap(Inh|Prm|Eff|Bnd)"
            "/proc/self/status"
        }
    }

    install {
        mkdir "${dest}/usr/share/probe-pbs-caps"
        write "${dest}/usr/share/probe-pbs-caps/proof.txt" "a PBS recipe declaring CAP_SYS_ADMIN was published and built\n"
        require file "${dest}/usr/share/probe-pbs-caps/proof.txt" {
            exists
        }
    }
}
