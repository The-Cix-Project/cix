# probe-pbs-caps -- does cixd read a PBS recipe's capability NAMES and
# its metadata block? (cix-build-system#161 and #162, both closed)
#
# This recipe could not be PUBLISHED at all until v2.57.219. `cbs
# explain --json` reported a capability COUNT, and cixd refused any
# PBS recipe declaring one rather than building it without the
# capability -- a count of 1 does not say whether the recipe asked for
# CAP_SYS_ADMIN or CAP_NET_ADMIN, and granting by count would be worse
# than not supporting the field. So the publish succeeding is itself
# half the result.
#
# The other half is whether the capability is actually GRANTED to the
# build container rather than merely parsed. CAP_SYS_ADMIN is
# capability 21, so it is bit 21 of the mask -- 0x200000. The build
# phase prints its own /proc/self/status and asserts the bit, with
# both the mask and the arithmetic in the log so the answer is
# readable rather than trusted.
#
# EXPECTED RESULT: the install SUCCEEDS; the build log shows CapEff
# with bit 21 set; and `GET /v1/pkg/recipes/probe-pbs-caps` reports
# the changelog below rather than null -- which is the metadata block
# being read, since CPDL has no `changelog` keyword of its own.
#
# The source is this platform's own tarball, for the same reason
# probe-pbs uses it: a probe needs a real checksum-verified fetch to
# reach its build phase, and this is the archive certain to fetch.
package "probe-pbs-caps" {
    version "1"
    release 1
    format "cixpkg"

    metadata {
        "changelog" "1: proves cixd reads capability NAMES and the metadata block (cix-build-system#161, #162). Publishable at all only from cix v2.57.219."
    }

    capability "CAP_SYS_ADMIN"

    sources {
        main "cixsrc" {
            url "https://osakka:{{REPO_TOKEN}}@git.home.arpa/api/v1/repos/itdlabs/cix/archive/v2.57.219.tar.gz"
            sha256 "d4c2727bb495dfcf63f1b82157183794cf95957abca6c351baff6979d5949d0d"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "bash"
            tool "coreutils"
            tool "grep"
        }
    }

    build {
        # The whole mask, printed before anything is asserted, so a
        # failure says what the kernel actually granted rather than
        # only that an assertion failed.
        run "bash" {
            "-c"
            "grep -E '^Cap(Inh|Prm|Eff|Bnd)' /proc/self/status"
        }
        # CAP_SYS_ADMIN is capability 21 -> 0x200000. Compared as a
        # number rather than by string match on the hex, because the
        # mask's other bits differ between hosts and a substring test
        # would pass on an unrelated value.
        run "bash" {
            "-c"
            "eff=$(grep '^CapEff' /proc/self/status | tr -d 'CapEff:\\t '); printf 'CapEff=0x%s  CAP_SYS_ADMIN(bit 21)=' \"$eff\"; if (( 0x$eff & (1 << 21) )); then echo GRANTED; else echo ABSENT; exit 1; fi"
        }
    }

    install {
        mkdir "${dest}/usr/share/probe-pbs-caps"
        write "${dest}/usr/share/probe-pbs-caps/proof.txt" "CAP_SYS_ADMIN granted to a PBS build\n"
        require file "${dest}/usr/share/probe-pbs-caps/proof.txt" {
            exists
        }
    }
}
