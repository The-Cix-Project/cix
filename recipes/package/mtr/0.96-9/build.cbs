# mtr, as a PBS recipe (ADR-0305 stage 4).
#
# A translation of recipes/package/mtr/0.96-8/build.sh, and the worked
# example of `stage library` (cix-build-system#178).
#
# THE LIBRARY SEARCH. The shell recipe ended with twelve lines:
#
#     resolv=""
#     for d in /usr/lib /lib/x86_64-linux-gnu /usr/lib/x86_64-linux-gnu; do
#             if [ -e "$d/libresolv.so.2" ]; then resolv="$d/libresolv.so.2"; break; fi
#     done
#     [ -n "$resolv" ] || {
#             echo "mtr: libresolv.so.2 is not in the build sandbox -- is glibc declared?" >&2
#             exit 1
#     }
#     mkdir -p "$PKG_DESTDIR/usr/lib"
#     cp -a "$resolv" "$PKG_DESTDIR/usr/lib/"
#
# -- a first-match search over three multiarch directories, a guard
# naming the declared dependency that should have provided the library,
# and a mode-preserving copy. That is one operation now:
#
#     stage library "libresolv.so.2" into "${dest}/usr/lib"
#
# and the hardcoded multiarch list is gone with it. Four recipes in this
# corpus hand-roll that same search; this is the first converted, and
# the list was going to rot in all four the day a build host's layout
# changed.
#
# The weak __dso_handle stub stays as it was: glibc's static-destructor
# bookkeeping wants a symbol a direct tcc link does not always supply,
# and `weak` means it is superseded wherever the toolchain has a real
# one. `$(pwd)` needs no equivalent -- the shell wrote it from inside a
# directory this recipe already names.
package "mtr" {
    version "0.96"
    release 9
    format "cixpkg"

    license "GPL-2.0-only"

    sources {
        main "mtr" {
            url "https://github.com/traviscross/mtr/archive/refs/tags/v0.96.tar.gz"
            sha256 "73e6aef3fb6c8b482acb5b5e2b8fa7794045c4f2420276f035ce76c5beae632d"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
            tool "findutils"
            tool "diffutils"
            tool "pkgconf"
            tool "ncurses"
            tool "autoconf"
            tool "automake"
            tool "libtool"
            tool "m4"
            # glibc, and it is not incidental: libresolv.so.2 is what
            # `stage library` below goes looking for, and glibc is what
            # provides it. The shell recipe's own failure message said
            # so ("is glibc declared?").
            tool "glibc"
        }
        runtime {
            package "ncurses"
        }
    }

    metadata {
        "artifact_sha256" "3335dc5583f0c654780ff11eac2c78c2d0fcff7a952aa751957dcc8da08c033a"
        "changelog" "0.96-9: converted from build.sh to build.cbs (ADR-0305 stage 4), and the first recipe to use stage library (cix-build-system#178). Twelve lines of first-match search over three multiarch directories, a guard naming the dependency that should have provided libresolv.so.2, and a cp -a become one operation -- and the hardcoded multiarch list goes with them. Stops deleting usr/share/{man,bash-completion} (ADR-0306, #491)."
    }

    prepare {
        run "ls" {
            "-la"
            "${src}/mtr"
        }
        require directory "${src}/mtr/mtr-0.96" {
            exists
        }
        write "${src}/mtr/mtr-0.96/dso_stub.c" "void *__dso_handle __attribute__((weak)) = (void *)0;\n"
    }

    build {
        cd "${src}/mtr/mtr-0.96" {
            run "tcc" {
                "-c"
                "dso_stub.c"
                "-o"
                "dso_stub.o"
            }
            # mtr ships no configure; bootstrap.sh generates it, which
            # is why autoconf/automake/libtool/m4 are declared above.
            run "./bootstrap.sh" {
            }
            run "./configure" {
                "--prefix=/usr"
                "--without-gtk"
                "--without-jansson"
                "--without-ipinfo"
                "LIBS=${src}/mtr/mtr-0.96/dso_stub.o"
                env "CC" = "tcc"
            }
            run "make" {
                jobs $jobs
            }
        }
    }

    install {
        cd "${src}/mtr/mtr-0.96" {
            run "make" {
                "DESTDIR=${dest}"
                "install"
            }
        }
        # The whole of the shell recipe's twelve-line search, and it
        # preserves mode and link-ness the way `cp -a` did.
        stage library "libresolv.so.2" into "${dest}/usr/lib"
        require file "${dest}/usr/sbin/mtr" {
            exists
            nonempty
        }
    }
}
