# screen -- terminal multiplexer. Converted from build.sh to build.cbs
# (ADR-0305 stage 4, #487).
#
# WHAT CHANGES:
#
#   usr/share/man   -- no longer deleted (ADR-0306, #491). Exactly one
#                      of the withdrawn categories.
#   usr/bin/screen  -- rebuilt as a relative symlink to screen-5.0.2,
#                      rather than left as whatever make install made
#                      it. CIXPKG refuses a regular file whose link
#                      count is not 1 (cix-build-system#182), and
#                      screen installs the real binary under its
#                      versioned name and then creates the
#                      unversioned one beside it. The shell recipe's
#                      comment calls that a symlink; binutils and
#                      automake both turned out to be hard links, and
#                      the remove-then-symlink below is correct
#                      EITHER WAY -- with a hard link both names are
#                      one file, so removing one leaves the other
#                      whole.
#
# THE chmod IS NOT COSMETIC. make install applies chmod 4755 to the
# binary unconditionally, regardless of --disable-pam, and CIXPKG
# refuses a setuid mode outright -- so without this the package does
# not build at all, where under tar.gz it merely shipped an unaudited
# setuid-root binary. The posture is unchanged and now enforced: this
# jump box is single-operator (each SSH login is its own
# container-level identity), and setuid exists only for the
# cross-user pty chown that multi-user session sharing needs.
#
# --disable-pam: no PAM recipe exists here. --disable-socket-dir:
# these images have no multi-user /tmp convention for a shared global
# socket directory to defend against, and screen's per-user
# $HOME-relative default is sufficient.
# The -iquote count is now measured, not guessed: `exactly 1` was a
# claim in 5.0.2-6 and that build reached its install phase, so the
# Makefile really does carry exactly one.
#
package "screen" {
    version "5.0.2"
    release 7
    format "cixpkg"

    sources {
        main "screen" {
            url "https://ftp.gnu.org/gnu/screen/screen-5.0.2.tar.gz"
            sha256 "ca9a2c7e240919bc7ac12124593ae4529bb4eb5f7349d8857829b7e3f0b3b332"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
            tool "findutils"
            tool "diffutils"
            tool "ncurses"
            tool "libxcrypt"
        }
        runtime {
            package "ncurses"
            # libcrypt.so.2. glibc 2.44 moved crypt() out of libc, so
            # screen links libxcrypt -- and every revision back to
            # 5.0.2-3, which added it, declared it as a BUILD tool
            # only. That puts it in the sandbox, where the link is
            # recorded, and leaves the runtime dependency undeclared.
            # The #389 install gate refused 5.0.2-6 for exactly that,
            # naming the soname; the shell revisions predate the gate
            # and shipped with the hole.
            package "libxcrypt"
        }
    }

    metadata {
        "artifact_sha256" "cc377ec44387faba19ecf547eb6f2bdbf8cf1716f4af2b7a020f09b857052db1"
        "changelog" "5.0.2-7: declares libxcrypt as a RUNTIME dependency. screen links libcrypt.so.2 -- glibc 2.44 moved crypt() out of libc -- and 5.0.2-3 through -6 declared it as a build tool only, so the link was recorded and the dependency was not. The #389 gate refused 5.0.2-6 naming the soname. 5.0.2-6: converted to build.cbs (ADR-0305) as a .cixpkg (ADR-0307); keeps usr/share/man (#491); usr/bin/screen becomes a symlink and chmod 0755 is load-bearing, CIXPKG refusing a link count above 1 and a setuid mode."
    }

    build {
        cd "${src}/screen/screen-5.0.2" {
            run "./configure" {
                "--prefix=/usr"
                "--disable-pam"
                "--disable-socket-dir"
                env "CC" = "tcc"
            }
            # TCC does not implement -iquote, GCC's "search this path
            # for quoted includes only" form, and screen's generated
            # Makefile passes -iquote. unconditionally:
            #
            #   tcc: error: invalid option -- '-iquote.'
            #
            # -I. is a superset -- -iquote restricts a path to "..."
            # includes where -I applies it to both -- and the
            # directory is the source root either way.
            #
            # exactly 1 is a claim about the Makefile, not a known
            # count: the shell recipe used a global sed and a
            # grep-for-survivors afterwards, so the real number was
            # never recorded. If it is wrong the build says "source
            # edit expected 1 matches but found N", which is the
            # documented way to learn it and a better guard than the
            # sed ever had.
            replace "${src}/screen/screen-5.0.2/Makefile" {
                from "-iquote."
                to "-I."
                exactly 1
            }
            run "make" {
                jobs $jobs
            }
        }
    }

    install {
        cd "${src}/screen/screen-5.0.2" {
            run "make" {
                "install"
                "DESTDIR=${dest}"
            }
        }
        chmod 0755 "${dest}/usr/bin/screen-5.0.2"
        remove "${dest}/usr/bin/screen"
        symlink "screen-5.0.2" to "${dest}/usr/bin/screen"
        require file "${dest}/usr/bin/screen-5.0.2" {
            exists
            nonempty
        }
    }
}
