# readline -- libreadline and libhistory, kept so other packages can
# build against them. Converted from build.sh to build.cbs (ADR-0305
# stage 4, #487).
#
# WHAT CHANGES:
#
#   usr/share/{man,info,doc}  -- no longer deleted (ADR-0306, #491).
#   usr/share/readline        -- the removal is GONE, and not for
#                                ADR-0306's reason. 8.3-3 failed
#                                with:
#
#                                  filesystem operation failed:
#                                  ${dest}/usr/share/readline;
#                                  errno=2
#
#                                The directory is not there to
#                                remove. `rm -rf` tolerates that and
#                                `remove tree` does not, so a
#                                removal the shell recipe had been
#                                performing as a no-op became a
#                                build failure the moment it was
#                                stated honestly. This configure
#                                installs no examples tree; the
#                                comment claiming one was describing
#                                a different build of readline.
#
# THE BUILD GUARD MOVED RATHER THAN DISAPPEARED. The shell form ran
#
#     found=$(find . -name 'libreadline.so*' -o -name 'libhistory.so*')
#     [ -z "$found" ] && exit 1
#
# to catch a configure that silently produced no shared library at
# all. `find` prints many lines and CPDL cannot bind or assert on
# multi-line output (cix-build-system#185), so the same question is
# asked of the INSTALLED tree instead: if no shared library was
# built, `make install` puts none there and the assertion fails. The
# check is not weaker for moving -- it is narrower, naming the exact
# file rather than any match anywhere in the tree, which is what the
# find was standing in for because it did not know where the build
# would put it.
package "readline" {
    version "8.3"
    release 4
    format "cixpkg"

    sources {
        main "readline" {
            url "https://ftp.gnu.org/gnu/readline/readline-8.3.tar.gz"
            sha256 "fe5383204467828cd495ee8d1d3c037a7eba1389c22bc6a041f627976f9061cc"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
            tool "findutils"
            tool "diffutils"
            tool "ncurses"
        }
        runtime {
            package "ncurses"
        }
    }

    metadata {
        "changelog" "8.3-4: converted from build.sh to build.cbs (ADR-0305 stage 4) and published as a .cixpkg (ADR-0307). Same tarball at the same digest and the same configure line. Stops deleting usr/share/{man,info,doc} (ADR-0306, #491). The usr/share/readline removal is gone too, for a different reason: 8.3-3 failed with errno=2 because this configure never creates it -- rm -rf tolerated the absence, remove tree does not."
    }

    build {
        cd "${src}/readline/readline-8.3" {
            run "./configure" {
                "--prefix=/usr"
                "--with-curses"
                "--enable-shared"
                "--disable-static"
                env "CC" = "tcc"
            }
            run "make" {
                jobs $jobs
            }
        }
    }

    install {
        cd "${src}/readline/readline-8.3" {
            run "make" {
                "install"
                "DESTDIR=${dest}"
            }
        }
        # The real files, never the soname links (cix-build-system#175).
        require file "${dest}/usr/lib/libreadline.so.8.3" {
            exists
            nonempty
        }
        require file "${dest}/usr/lib/libhistory.so.8.3" {
            exists
            nonempty
        }
    }
}
