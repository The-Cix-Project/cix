# libmnl, as a PBS recipe (ADR-0305 stage 4).
#
# A translation of recipes/package/libmnl/1.0.5-5/build.sh, and the
# first recipe here to use two CPDL features that did not exist a day
# ago. It is worth reading as the worked example of both.
#
# THE VERSION-SCRIPT STRIP (cix-build-system#177). The shell recipe did:
#
#     sed -i 's/-Wl,--version-script[=,][^ ]*//g' src/Makefile
#     grep -q -- '--version-script' src/Makefile && exit 1
#
# TCC does not implement linker version scripts, so the flag and its
# argument have to go. No literal match can express that: the argument
# is a filename, different at every site. `replace ... until whitespace`
# matches from a literal prefix to the next whitespace, which is exactly
# the shape of a flag carrying an argument -- and `exactly N` makes it
# an assertion, so the `grep ... && exit 1` guard behind it is not
# translated but subsumed. Six recipes in this corpus perform this same
# strip; this is the first converted.
#
# THE SONAME ASSERTION (cix-build-system#175). The shell recipe's
# `test -e "$PKG_DESTDIR/usr/lib/libmnl.so.0"` checks a SYMLINK, and
# `require file` matches regular files only -- asserting a link reported
# "does not exist" while the link sat right there.
#
# The fix is its own assertion kind rather than a property on `file`,
# which is the better shape and cost one refused publish to learn:
# `require file { target ... }` is rejected with "file assertion must
# use contains, same_as, or nonempty", and `require symlink` is what
# takes `target`. It asserts both that the link exists and where it
# points -- more than `test -e` ever checked, since a link to the wrong
# soname passed the old test and fails this one.
#
# NOT translated: `rm -f "$PKG_DESTDIR/usr/lib"/*.la`. ADR-0251's
# finalize phase drops every .la after this phase, and `remove glob`
# fails on a glob matching nothing.
package "libmnl" {
    version "1.0.5"
    release 7
    format "cixpkg"

    license "LGPL-2.1-or-later"

    sources {
        main "libmnl" {
            url "https://www.netfilter.org/projects/libmnl/files/libmnl-1.0.5.tar.bz2"
            sha256 "274b9b919ef3152bfb3da3a13c950dd60d6e2bcd54230ffeca298d03b40d0525"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
            tool "findutils"
            tool "diffutils"
            # bzip2, and NOT because the build uses it. The source is a
            # .tar.bz2, and a PBS recipe's sources are extracted INSIDE
            # the build container by cbs -- where a shell recipe's are
            # extracted host-side by cixd, using the host's own tools.
            #
            # So a compressor the archive needs has to be declared. This
            # platform's libarchive has no built-in bz2 filter and shells
            # out, and 1.0.5-6 failed before any phase ran:
            #
            #   source `libmnl`: cannot open archive: Can't initialize
            #   filter; unable to run program "bzip2 -d"
            #
            # The shell revision never needed the declaration because it
            # never did the work. Any converted recipe whose source is
            # .bz2 (or any format libarchive farms out) needs the same.
            tool "bzip2"
        }
    }

    metadata {
        "artifact_sha256" "dc6f661c52e1f7c6ad3f11fd5d292f64dacb1a14bf79c2eb4235394b4b3e893a"
        "changelog" "1.0.5-7: converted from build.sh to build.cbs (ADR-0305 stage 4). First recipe to use replace ... until whitespace (cix-build-system#177) for the -Wl,--version-script strip TCC needs, since no literal match can reach the flag's argument, and require symlink { target } for the soname link (#175). Declares bzip2: a PBS recipe's sources are extracted inside the build container, so a .tar.bz2 needs the compressor declared where a shell recipe did not."
    }

    prepare {
        run "ls" {
            "-la"
            "${src}/libmnl"
        }
        require directory "${src}/libmnl/libmnl-1.0.5" {
            exists
        }
    }

    build {
        cd "${src}/libmnl/libmnl-1.0.5" {
            run "./configure" {
                "--prefix=/usr"
                "--libdir=/usr/lib"
                "--disable-static"
                env "CC" = "tcc"
            }
        }
        # After configure, which generates the Makefile this edits.
        #
        # `exactly 1` is a first declaration, not a measurement: a glob
        # or a repeated flag makes the real total something only the
        # build can report, and a wrong count fails loudly naming both
        # numbers. If this says "found N", N is the answer.
        replace "${src}/libmnl/libmnl-1.0.5/src/Makefile" {
            from "-Wl,--version-script"
            until whitespace
            to ""
            exactly 1
        }
        cd "${src}/libmnl/libmnl-1.0.5" {
            run "make" {
                jobs $jobs
            }
        }
    }

    install {
        cd "${src}/libmnl/libmnl-1.0.5" {
            run "make" {
                "install"
                "DESTDIR=${dest}"
            }
        }
        # The real file, and then the soname link BY ITS TARGET.
        require file "${dest}/usr/lib/libmnl.so.0.2.0" {
            exists
            nonempty
        }
        require symlink "${dest}/usr/lib/libmnl.so.0" {
            exists
            target "libmnl.so.0.2.0"
        }
        require file "${dest}/usr/include/libmnl/libmnl.h" {
            exists
            nonempty
        }
        require file "${dest}/usr/lib/pkgconfig/libmnl.pc" {
            exists
            nonempty
        }
    }
}
