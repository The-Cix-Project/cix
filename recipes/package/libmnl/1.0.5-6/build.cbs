# libmnl, as a PBS recipe (ADR-0305 stage 4).
#
# A translation of recipes/package/libmnl/1.0.5-5/build.sh, and the
# first recipe here to use two CPDL features that did not exist a day
# ago. It is worth reading as the worked example of both.
#
# THE VERSION-SCRIPT STRIP (cix-build-system#177). The shell recipe did:
#
#     sed -i 's/-Wl,--version-script[=,][^ ]*//g' src/Makefile
#     grep -q -- '--version-script' src/Makefile && exit 1
#
# TCC does not implement linker version scripts, so the flag and its
# argument have to go. No literal match can express that: the argument
# is a filename, different at every site. `replace ... until whitespace`
# matches from a literal prefix to the next whitespace, which is exactly
# the shape of a flag carrying an argument -- and `exactly N` makes it
# an assertion, so the `grep ... && exit 1` guard behind it is not
# translated but subsumed. Six recipes in this corpus perform this same
# strip; this is the first converted.
#
# THE SONAME ASSERTION (cix-build-system#175). The shell recipe's
# `test -e "$PKG_DESTDIR/usr/lib/libmnl.so.0"` checks a SYMLINK, and
# `require file` matches regular files only -- asserting a link reported
# "does not exist" while the link sat right there. `require file
# { target ... }` now asserts both that the link exists and where it
# points, which is more than `test -e` ever checked: a link to the wrong
# soname passed the old test and fails this one.
#
# NOT translated: `rm -f "$PKG_DESTDIR/usr/lib"/*.la`. ADR-0251's
# finalize phase drops every .la after this phase, and `remove glob`
# fails on a glob matching nothing.
package "libmnl" {
    version "1.0.5"
    release 6
    format "cixpkg"

    license "LGPL-2.1-or-later"

    sources {
        main "libmnl" {
            url "https://www.netfilter.org/projects/libmnl/files/libmnl-1.0.5.tar.bz2"
            sha256 "274b9b919ef3152bfb3da3a13c950dd60d6e2bcd54230ffeca298d03b40d0525"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
            tool "findutils"
            tool "diffutils"
        }
    }

    metadata {
        "changelog" "1.0.5-6: converted from build.sh to build.cbs (ADR-0305 stage 4), and the first recipe to use replace ... until whitespace (cix-build-system#177) for the -Wl,--version-script strip TCC needs -- no literal match could reach the flag's argument. exactly N subsumes the shell recipe's grep guard. The soname check becomes require file { target }, which asserts where the link points rather than only that something is there (#175). Stops deleting usr/lib/*.la, which finalize already removes."
    }

    prepare {
        run "ls" {
            "-la"
            "${src}/libmnl"
        }
        require directory "${src}/libmnl/libmnl-1.0.5" {
            exists
        }
    }

    build {
        cd "${src}/libmnl/libmnl-1.0.5" {
            run "./configure" {
                "--prefix=/usr"
                "--libdir=/usr/lib"
                "--disable-static"
                env "CC" = "tcc"
            }
        }
        # After configure, which generates the Makefile this edits.
        #
        # `exactly 1` is a first declaration, not a measurement: a glob
        # or a repeated flag makes the real total something only the
        # build can report, and a wrong count fails loudly naming both
        # numbers. If this says "found N", N is the answer.
        replace "${src}/libmnl/libmnl-1.0.5/src/Makefile" {
            from "-Wl,--version-script"
            until whitespace
            to ""
            exactly 1
        }
        cd "${src}/libmnl/libmnl-1.0.5" {
            run "make" {
                jobs $jobs
            }
        }
    }

    install {
        cd "${src}/libmnl/libmnl-1.0.5" {
            run "make" {
                "install"
                "DESTDIR=${dest}"
            }
        }
        # The real file, and then the soname link BY ITS TARGET.
        require file "${dest}/usr/lib/libmnl.so.0.2.0" {
            exists
            nonempty
        }
        require file "${dest}/usr/lib/libmnl.so.0" {
            exists
            target "libmnl.so.0.2.0"
        }
        require file "${dest}/usr/include/libmnl/libmnl.h" {
            exists
            nonempty
        }
        require file "${dest}/usr/lib/pkgconfig/libmnl.pc" {
            exists
            nonempty
        }
    }
}
