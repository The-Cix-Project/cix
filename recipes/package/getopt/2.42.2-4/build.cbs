# getopt -- GNU getopt(1), the long-option argument normaliser, built
# standalone out of the util-linux tree. Converted from build.sh to
# build.cbs (ADR-0305 stage 4, #487).
#
# NOTHING TO RESTORE under #491: this recipe never deleted anything.
# It configures, builds one target and copies one binary.
#
# It exists because ccan's create-ccan-tree, a build step of
# sbsigntools, parses its arguments with
#
#   getopt -o ab: --long copy-all,build-type: ...
#
# and failed in a composed build environment with "getopt: command
# not found". Bash's builtin getopts cannot substitute: it has no
# --long support at all, which is precisely what that call uses. The
# alternative was patching argument parsing out of third-party source
# to route around a tool we simply did not have.
#
# NOT "--disable-all-programs --enable-getopt", which -1 tried by
# analogy with libuuid and which cannot work. From util-linux's own
# m4/ul.m4: UL_BUILD_INIT registers no AC_ARG_ENABLE for a PROGRAM --
# it reads $enable_getopt, but --disable-all-programs sets
# ul_default_estate=no and that branch takes precedence, forcing
# build_getopt=no regardless. autoconf duly warned "unrecognized
# options: --enable-getopt" and the build then succeeded while
# producing nothing. libuuid gets away with the same shape only
# because LIBRARIES use a different macro that does register the
# option.
#
# The supported route is the one configure prints itself -- "Type
# 'make' or 'make <utilname>' to compile": configure normally, then
# build the single target. util-linux is non-recursive automake, so
# the binary lands at the top of the build tree as ./getopt.
package "getopt" {
    version "2.42.2"
    release 4
    format "cixpkg"

    sources {
        main "util-linux" {
            url "https://www.kernel.org/pub/linux/utils/util-linux/v2.42/util-linux-2.42.2.tar.xz"
            sha256 "03a05d3adf9602ef128f2da05b84b3205ce60c351e5737c0370f74000679ce8a"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "bash"
            tool "coreutils"
            tool "make"
            tool "linux-headers"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
            tool "pkgconf"
            tool "findutils"
        }
    }

    metadata {
        "artifact_sha256" "33b42b4d4de58a405aa43a19ddbcfcb1aa00201e8cc952bc981ea104d06c564b"
        "changelog" "2.42.2-4: converted from build.sh to build.cbs (ADR-0305 stage 4) and published as a .cixpkg (ADR-0307). Same tarball at the same digest, the same configure line and the same single make target. Nothing to restore under ADR-0306: this recipe never deleted anything."
    }

    build {
        cd "${src}/util-linux/util-linux-2.42.2" {
            run "./configure" {
                "--prefix=/usr"
                "--without-python"
                "--without-systemd"
                "--without-udev"
                env "CC" = "tcc"
            }
            run "make" {
                "getopt"
            }
        }
    }

    install {
        mkdir "${dest}/usr/bin" chmod 0755
        copy "${src}/util-linux/util-linux-2.42.2/getopt" to "${dest}/usr/bin/getopt"
        chmod 0755 "${dest}/usr/bin/getopt"
        # Asserted rather than assumed: a configure that quietly did
        # not build getopt would otherwise produce an empty package
        # whose absence only surfaces in whatever recipe next
        # declares it.
        require file "${dest}/usr/bin/getopt" {
            exists
            nonempty
        }
    }
}
