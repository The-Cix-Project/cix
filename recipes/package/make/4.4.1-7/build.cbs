# make, as a PBS recipe (ADR-0305 stage 4).
#
# A translation of the previous build.sh: same tarball at the same
# digest, the same configure invocation, the same `make install`.
#
# The shell recipe deleted the whole of usr/share; ADR-0306 withdrew that practice (#491) and the line is gone.
package "make" {
    version "4.4.1"
    release 7
    format "cixpkg"

    license "GPL-3.0-or-later"

    sources {
        main "make" {
            url "https://ftp.gnu.org/gnu/make/make-4.4.1.tar.gz"
            sha256 "dd16fb1d67bfab79a72f5e8390735c49e3e8e70b4945a15ab1f81ddb78658fb3"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
        }
    }

    metadata {
        "artifact_sha256" "e5b6c967ee85ccf6dba9aadab0f6fdcd85764d6f5b197904f11ca758b785d128"
        "changelog" "4.4.1-7: converted from build.sh to build.cbs (ADR-0305 stage 4). Same tarball at the same digest and the same configure invocation. Stops deleting its own documentation (ADR-0306, #491)."
    }

    prepare {
        run "ls" {
            "-la"
            "${src}/make"
        }
        require directory "${src}/make/make-4.4.1" {
            exists
        }
    }

    build {
        cd "${src}/make/make-4.4.1" {
            run "./configure" {
                "--prefix=/usr"
                env "CC" = "tcc"
            }
            run "make" {
                "MAKEINFO=true"
                jobs $jobs
            }
        }
    }

    install {
        cd "${src}/make/make-4.4.1" {
            run "make" {
                "install"
                "DESTDIR=${dest}"
                "MAKEINFO=true"
            }
        }
        require file "${dest}/usr/bin/make" {
            exists
            nonempty
        }
    }
}
