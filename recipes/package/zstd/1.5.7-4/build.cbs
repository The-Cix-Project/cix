# zstd -- libzstd, which CIXPKG itself compresses with. Converted
# from build.sh to build.cbs (ADR-0305 stage 4, #487).
#
# Library only: `make -C lib`, never the top-level target, so the
# `zstd` command-line tool is not built or installed. Nothing here
# needs it -- libarchive and cbs link the library.
#
# WHAT CHANGES: `rm -f usr/lib/*.a` is gone. ADR-0251's finalize drops
# a static archive when a shared object sits beside it, and this
# package installs libzstd.so.1.5.7, so the rule applies. Checked
# rather than assumed, the same way libtool's was -- pkgconf is the
# counter-example that keeps its own removal, being --disable-shared.
#
# The "was a shared library built at all" guard survives as a
# `require file` on the build tree before the install runs, which is
# what the shell form's `[ ! -f lib/libzstd.so ]` test was.
package "zstd" {
    version "1.5.7"
    release 4
    format "cixpkg"

    sources {
        main "zstd" {
            url "https://github.com/facebook/zstd/releases/download/v1.5.7/zstd-1.5.7.tar.gz"
            sha256 "eb33e51f49a15e023950cd7825ca74a4a2b43db8354825ac24fc1b7ee09e6fa3"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "binutils"
            tool "findutils"
        }
    }

    metadata {
        "changelog" "1.5.7-4: converted from build.sh to build.cbs (ADR-0305 stage 4) and published as a .cixpkg (ADR-0307). Same tarball at the same digest and the same library-only make -C lib, so no zstd command-line tool is built. Stops deleting usr/lib/*.a, which finalize already removes given libzstd.so.1.5.7 sits beside it. The no-shared-library guard survives as a require file on the build tree."
    }

    build {
        cd "${src}/zstd/zstd-1.5.7" {
            run "make" {
                "-C"
                "lib"
                "CC=tcc"
                jobs $jobs
            }
        }
        # The shell form's own guard, moved to where CPDL can state
        # it: if no shared library was produced, stop here rather
        # than installing a package with nothing in it.
        require file "${src}/zstd/zstd-1.5.7/lib/libzstd.so" {
            exists
        }
    }

    install {
        cd "${src}/zstd/zstd-1.5.7" {
            run "make" {
                "-C"
                "lib"
                "install"
                "CC=tcc"
                "PREFIX=/usr"
                "LIBDIR=/usr/lib"
                "DESTDIR=${dest}"
            }
        }
        # The real file, never the soname link -- require file
        # rejects a symlink as "does not exist"
        # (cix-build-system#175), which mtools cost a build to relearn.
        require file "${dest}/usr/lib/libzstd.so.1.5.7" {
            exists
            nonempty
        }
    }
}
