# vim, as a PBS recipe (ADR-0305 stage 4).
#
# A translation of recipes/package/vim/9.1.1428-3/build.sh: same
# tarball at the same digest, same configure switches, same
# `make install`.
#
# ONE deliberate behaviour change, and it is a fix rather than a
# translation artefact. The shell recipe ended with
#
#     rm -rf "$PKG_DESTDIR/usr/share"/{man,doc,locale}
#
# which [ADR-0306](../../../../docs/adr/0306-a-package-keeps-its-documentation-and-its-licence.md)
# withdrew as a practice: the platform removes what it CANNOT use, never
# what it merely does not read. Those three lines are gone here. vim is
# one of the 57 recipes counted by #491 that kept doing their own
# pruning after the finalize policy stopped, so the artifact this
# produces is larger than -3's and carries vim's own documentation and
# licence, which is the point.
package "vim" {
    version "9.1.1428"
    release 4
    format "cixpkg"

    # vim's own licence, a charityware variant of Vim itself -- see
    # runtime/doc/uganda.txt in the tree this builds. SPDX calls it
    # Vim, and it is not GPL despite being GPL-compatible.
    license "Vim"

    sources {
        main "vim" {
            url "https://github.com/vim/vim/archive/refs/tags/v9.1.1428.tar.gz"
            sha256 "d96a8208f7756958d5bdb2464e9fdb770a8400e3aafac328e58c81c2477124f1"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
            tool "findutils"
            tool "diffutils"
            tool "ncurses"
        }
        runtime {
            package "ncurses"
        }
    }

    metadata {
        "artifact_sha256" "ba40890c906a0de84f2f9802bc304f85020c890c1b79fa1af9bd78e4e49111e6"
        "changelog" "9.1.1428-4: converted from build.sh to build.cbs (ADR-0305 stage 4), and stops deleting its own usr/share/{man,doc,locale} (ADR-0306, #491). Same tarball at the same digest and the same configure switches; the artifact is larger than -3's because it now carries vim's documentation and licence rather than removing them."
    }

    prepare {
        run "ls" {
            "-la"
            "${src}/vim"
        }
        require directory "${src}/vim/vim-9.1.1428" {
            exists
        }
    }

    build {
        # CC as an ENVIRONMENT variable, not a make override: the shell
        # form set it as a prefix assignment on ./configure, which is
        # what configure reads to choose its compiler. (Contrast
        # iputils, where every value is a make command-line override and
        # env would be wrong. The distinction is per-recipe, not a
        # style.)
        cd "${src}/vim/vim-9.1.1428" {
            run "./configure" {
                "--prefix=/usr"
                "--without-x"
                "--disable-gui"
                "--disable-nls"
                "--disable-channel"
                "--disable-netbeans"
                env "CC" = "tcc"
            }
            run "make" {
                jobs $jobs
            }
        }
    }

    install {
        cd "${src}/vim/vim-9.1.1428" {
            run "make" {
                "DESTDIR=${dest}"
                "install"
            }
        }
        require file "${dest}/usr/bin/vim" {
            exists
            nonempty
        }
    }
}
