# bison -- the GNU parser generator, and `yacc`, its own compatibility
# wrapper script. Converted from build.sh to build.cbs (ADR-0305
# stage 4, #487).
#
# WHAT CHANGES:
#
#   usr/share/{man,info,locale}  -- no longer deleted (ADR-0306,
#                                   #491). usr/share/bison was never
#                                   deleted and stays: it holds the
#                                   m4sugar skeleton files bison reads
#                                   at every real invocation, and an
#                                   early version of the shell recipe
#                                   wiped the whole of usr/share and
#                                   took them down by accident --
#                                   caught only when a real kernel
#                                   hostbuild tried to run bison.
#   usr/lib/*.a                  -- no longer deleted here. ADR-0251's
#                                   finalize phase already drops a
#                                   static archive, and a recipe
#                                   restating platform policy is a
#                                   second place for it to live.
#
# Two TCC workarounds carry over unchanged, both with their own long
# trail in the shell revision and in CLAUDE.md:
#
#   _GL_EXTERN_INLINE_STDHEADER_BUG=1  gnulib emits globally-visible
#     definitions of its inline helpers under TCC and libbison.a then
#     fails to link with dozens of "defined twice". This is gnulib's
#     own designed-in escape hatch onto `static _GL_UNUSED`.
#   dso_stub.o                        a bare tcc link can leave
#     __dso_handle undefined; a weak stub supplies it and is silently
#     superseded where the toolchain already has one.
#
# And the glibc 2.44 posix_spawn cache variables, which are truthful
# rather than a workaround: the function IS reachable by any
# translation unit that includes <spawn.h>, which is the only
# legitimate way C calls it, and autoconf's probe deliberately does
# not include the header. Full trail in m4/1.4.20-2.
#
# `$(pwd)` has no CPDL form and needs none: inside cd "${src}/bison/
# bison-3.8.2" that is the path itself, which the guide's idiom table
# says outright.
#
# No hard links: the installed 3.8.2-7 lists exactly bison and yacc,
# and yacc is a wrapper SCRIPT rather than a second name for the same
# inode -- checked before writing, after automake's versioned twins
# (cix-build-system#182) showed what to look for.
package "bison" {
    version "3.8.2"
    release 8
    format "cixpkg"

    sources {
        main "bison" {
            url "https://ftp.gnu.org/gnu/bison/bison-3.8.2.tar.gz"
            sha256 "06c9e13bdf7eb24d4ceb6b59205a4f67c2c7e7213119644430fe82fbd14a0abb"
        }
    }

    # m4 is load-bearing at RUNTIME, not just to build: bison compiles
    # in the absolute path of the m4 it was configured against and
    # shells out to it at parser-generation time. An image with bison
    # and no m4 fails at first real use rather than at install.
    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
            tool "findutils"
            tool "diffutils"
            tool "m4"
        }
        runtime {
            package "m4"
        }
    }

    metadata {
        "artifact_sha256" "6457cc49c17d477b7a5a367bd3c0d1b70357490ccb13d8cf5ca254565df8c667"
        "changelog" "3.8.2-8: converted from build.sh to build.cbs (ADR-0305 stage 4) and published as a .cixpkg (ADR-0307). Same tarball at the same digest, the same two TCC workarounds and the same posix_spawn cache variables. Stops deleting usr/share/{man,info,locale} (ADR-0306, #491) and usr/lib/*.a, which finalize already removes. usr/share/bison was never deleted and still is not: bison reads those skeleton files at every invocation."
    }

    prepare {
        require directory "${src}/bison/bison-3.8.2" {
            exists
        }
        write "${src}/bison/bison-3.8.2/dso_stub.c" "void *__dso_handle __attribute__((weak)) = (void *)0;\n"
    }

    build {
        cd "${src}/bison/bison-3.8.2" {
            run "tcc" {
                "-c"
                "dso_stub.c"
                "-o"
                "dso_stub.o"
            }
            # LIBS is a positional VAR=VALUE argument, which is how
            # autoconf reads it and how the shell form passed it; CC
            # and CFLAGS are environment. The two ac_cv_ variables are
            # environment too -- the shell form exported them above
            # the invocation because the line ended in a backslash.
            run "./configure" {
                "--prefix=/usr"
                "LIBS=${src}/bison/bison-3.8.2/dso_stub.o"
                env "CC" = "tcc"
                env "CFLAGS" = "-D_GL_EXTERN_INLINE_STDHEADER_BUG=1"
                env "ac_cv_func_posix_spawn_file_actions_addchdir" = "yes"
                env "ac_cv_func_posix_spawn_file_actions_addfchdir" = "yes"
            }
            run "make" {
                "MAKEINFO=true"
                jobs $jobs
            }
        }
    }

    install {
        cd "${src}/bison/bison-3.8.2" {
            run "make" {
                "install"
                "DESTDIR=${dest}"
                "MAKEINFO=true"
            }
        }
        require file "${dest}/usr/bin/bison" {
            exists
            nonempty
        }
        # The skeletons, asserted because deleting them by accident is
        # this recipe's own recorded failure and it was invisible until
        # something ran bison for real.
        require file "${dest}/usr/share/bison/skeletons/yacc.c" {
            exists
            nonempty
        }
    }
}
