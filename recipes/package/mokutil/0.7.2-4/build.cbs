# mokutil -- manages the UEFI Machine Owner Key list, for Secure
# Boot enrolment. Converted from build.sh to build.cbs (ADR-0305
# stage 4, #487).
#
# WHAT CHANGES: usr/share is no longer deleted (ADR-0306, #491). The
# shell recipe removed the whole tree, and --disable-bash-completion
# already keeps the completions out, so what returns is whatever
# make install otherwise puts there.
package "mokutil" {
    version "0.7.2"
    release 4
    format "cixpkg"

    sources {
        main "mokutil" {
            url "https://codeload.github.com/lcp/mokutil/tar.gz/refs/tags/0.7.2"
            sha256 "839d677c4fc9805f1565703ca32863e4652692c53da66a88ae9b9e30676f9e17"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "bash"
            tool "coreutils"
            tool "make"
            tool "linux-headers"
            tool "binutils"
            tool "autoconf"
            tool "automake"
            tool "m4"
            tool "pkgconf"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "findutils"
            tool "diffutils"
            tool "efivar"
            tool "keyutils"
            tool "libxcrypt"
            tool "openssl"
        }
        runtime {
            package "efivar"
            package "keyutils"
            package "libxcrypt"
            package "openssl"
        }
    }

    metadata {
        "changelog" "0.7.2-4: converted from build.sh to build.cbs (ADR-0305 stage 4) and published as a .cixpkg (ADR-0307). Same tarball at the same digest and the same autoreconf plus configure. Stops deleting usr/share (ADR-0306, #491); --disable-bash-completion already keeps the completions out."
    }

    prepare {
        # Listed before it is used, so the log answers what the
        # codeload tarball's top-level directory is actually called
        # rather than only whether one guess was right. This sandbox
        # unpacks nothing, so the box is the only place that can
        # answer it, and one build cycle is the price of that rule.
        run "ls" {
            "-la"
            "${src}/mokutil"
        }
        require directory "${src}/mokutil/mokutil-0.7.2" {
            exists
        }
    }

    build {
        cd "${src}/mokutil/mokutil-0.7.2" {
            run "autoreconf" {
                "-fi"
            }
            run "./configure" {
                "--prefix=/usr"
                "--disable-bash-completion"
                env "CC" = "tcc"
            }
            run "make" {
                jobs $jobs
            }
        }
    }

    install {
        cd "${src}/mokutil/mokutil-0.7.2" {
            run "make" {
                "install"
                "DESTDIR=${dest}"
            }
        }
        require file "${dest}/usr/bin/mokutil" {
            exists
            nonempty
        }
    }
}
