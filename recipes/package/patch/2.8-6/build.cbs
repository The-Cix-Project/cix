# patch, as a PBS recipe (ADR-0305 stage 4).
#
# A translation of the previous build.sh: same tarball at the same
# digest, the same configure invocation, the same `make install`.
#
# The shell recipe deleted the whole of usr/share; ADR-0306 withdrew that practice (#491) and the line is gone.
package "patch" {
    version "2.8"
    release 6
    format "cixpkg"

    license "GPL-3.0-or-later"

    sources {
        main "patch" {
            url "https://ftp.gnu.org/gnu/patch/patch-2.8.tar.xz"
            sha256 "f87cee69eec2b4fcbf60a396b030ad6aa3415f192aa5f7ee84cad5e11f7f5ae3"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
        }
    }

    metadata {
        "artifact_sha256" "b31e966ddf6c04b596fe945f66ad032cff5b070250b3bad905f03a1e96a4d0e1"
        "changelog" "2.8-6: converted from build.sh to build.cbs (ADR-0305 stage 4). Same tarball at the same digest and the same configure invocation. Stops deleting its own documentation (ADR-0306, #491)."
    }

    prepare {
        run "ls" {
            "-la"
            "${src}/patch"
        }
        require directory "${src}/patch/patch-2.8" {
            exists
        }
    }

    build {
        cd "${src}/patch/patch-2.8" {
            run "./configure" {
                "--prefix=/usr"
                env "CC" = "tcc"
            }
            run "make" {
                jobs $jobs
            }
        }
    }

    install {
        cd "${src}/patch/patch-2.8" {
            run "make" {
                "install"
                "DESTDIR=${dest}"
            }
        }
        require file "${dest}/usr/bin/patch" {
            exists
            nonempty
        }
    }
}
