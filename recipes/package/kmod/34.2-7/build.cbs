# 34.2-6 named six removals in its header and coded three. This
# revision codes all six. The three it dropped -- usr/share/fish,
# usr/share/zsh, usr/share/pkgconfig -- took the artifact from 7 files
# to 14, and the build did not care: nothing gates a package against
# the file list of the revision it replaces. The file-for-file compare
# is what found it, which is exactly the check ADR-0307 asks for.
#
# kmod -- modprobe, insmod, lsmod and friends, which are symlinks to
# the one kmod binary. Converted from build.sh to build.cbs (ADR-0305
# stage 4, #487).
#
# NOTHING TO RESTORE under #491, and that is worth stating rather
# than leaving implicit: every removal this recipe makes is its own
# judgement about what a package should ship, not the withdrawn
# documentation policy. They all stay:
#
#   usr/share/{bash-completion,fish,zsh}  completions for shells this
#                                         platform does not package
#   usr/share/pkgconfig, usr/include, usr/lib
#                                         libkmod's development side.
#                                         Nothing here links libkmod;
#                                         cixd talks to the kernel
#                                         directly (daemon/src/kmod.c)
#
# --disable-manpages means there are no man pages to have deleted in
# the first place.
package "kmod" {
    version "34.2"
    release 7
    format "cixpkg"

    sources {
        main "kmod" {
            url "https://www.kernel.org/pub/linux/utils/kernel/kmod/kmod-34.2.tar.xz"
            sha256 "5a5d5073070cc7e0c7a7a3c6ec2a0e1780850c8b47b3e3892226b93ffcb9cb54"
        }
    }

    requires {
        build {
            compiler "gcc"
            tool "make"
            tool "bash"
            tool "coreutils"
            tool "binutils"
            tool "linux-headers"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "findutils"
            tool "diffutils"
            tool "pkgconf"
            tool "zlib"
            tool "xz"
        }
    }

    toolchain "gcc" {
        reason "carried from the shell revision and NOT re-measured against the pinned tcc 0.9.28rc -- ADR-0226 says a reason is a measurement with a date on it, and this one has neither, so it is a candidate for re-measuring rather than a settled fact"
    }

    metadata {
        "artifact_sha256" "6bac1972085db75ccc7fd3d997edd75778ba94c288b35065e59855e735225c79"
        "changelog" "34.2-7: restores the usr/share/{fish,zsh,pkgconfig} removals that 34.2-6 dropped in translation -- its header named six and its install phase coded three, and the artifact went from 7 files to 14. Caught by the file-for-file compare against 34.2-2, not by the build. None are ADR-0306 categories: completions for shells this platform does not package, and pkgconfig data for a library nothing links. 34.2-6: converted to build.cbs (ADR-0305) as a .cixpkg (ADR-0307); gcc reason carried unverified."
    }

    build {
        cd "${src}/kmod/kmod-34.2" {
            run "./configure" {
                "--prefix=/usr"
                "--sbindir=/usr/bin"
                "--disable-manpages"
                env "CC" = "/usr/bin/gcc"
            }
            run "make" {
                jobs $jobs
            }
        }
    }

    install {
        cd "${src}/kmod/kmod-34.2" {
            run "make" {
                "install"
                "DESTDIR=${dest}"
            }
        }
        remove tree "${dest}/usr/share/bash-completion"
        remove tree "${dest}/usr/share/fish"
        remove tree "${dest}/usr/share/zsh"
        remove tree "${dest}/usr/share/pkgconfig"
        remove tree "${dest}/usr/include"
        remove tree "${dest}/usr/lib"
        # The real binary; modprobe, insmod and the rest are symlinks
        # to it, which require file rejects (cix-build-system#175).
        require file "${dest}/usr/bin/kmod" {
            exists
            nonempty
        }
    }
}
