# cbs v0.1.27-1: the release that gives CPDL what the recipe corpus
# actually needs.
#
# Built from the v0.1.27 TAG, and that is new -- every cbs revision
# since v0.1.23 had to pin a commit, because VERSION lagged the tag and
# upstream's own suite asserts that `cbs --version` equals the VERSION
# file, so a build from main could only ever report the stale number.
# cix-build-system#172 asked for a tagged release with VERSION moved;
# v0.1.27 is it, and this recipe can name a tag again.
#
# What this release adds, each read in its own source before packaging
# rather than taken from a closed issue. Of the five, `each` was
# partially present at v0.1.26 (a list-suffix form) and the other four
# were not there at all -- checked by fetching parser.c and validate.c
# at both refs:
#
#   each "n" in { ... } { ops }        #176  a COMPOUND body per list
#                                            item, bound as ${each.n}.
#                                            15 packages here need it;
#                                            38 of their loops have
#                                            multi-statement bodies.
#   replace { from X until whitespace  #177  match from a literal prefix
#             to "" }                        to a delimiter. Six recipes
#                                            strip -Wl,--version-script=
#                                            and its argument, which no
#                                            literal match could reach.
#   stage library "N" into PATH        #178  ship a shared library out of
#                                            the build sandbox without
#                                            naming which of three
#                                            multiarch directories holds
#                                            it. Four recipes hand-roll
#                                            that search today.
#   require file { target "..." }      #175  assert a SYMLINK and where
#                                            it points. `require file`
#                                            matches regular files only,
#                                            so before this a soname
#                                            link could not be checked
#                                            at all -- and asserting one
#                                            failed saying it "does not
#                                            exist".
#   env "ac_cv_prog_CC" = "tcc"        #179  lowercase environment names:
#                                            valid_environment_name()
#                                            now uses isalpha(). Autoconf
#                                            cache variables are the
#                                            supported way to correct a
#                                            probe that answers wrongly,
#                                            and 10 packages here set one.
#
#   plus #174, the bzip2 1.0.8 tarball cbs refused as an "unsafe
#   archive" while naming neither the entry nor the rule.
#
# Installing this is what unblocks the rest of the ADR-0305 stage 4
# conversion: 62 packages were blocked on those five shapes against 47
# convertible without them.
#
# The check phase carries a diagnostic this revision, and the header
# inside it records what four earlier build cycles measured about
# ./tests/archive-test. Restore a plain `make test` once that resolves.
#
package "cbs" {
    version "v0.1.27"
    release 1
    format "cixpkg"

    sources {
        main "cbs" {
            url "https://osakka:{{REPO_TOKEN}}@git.home.arpa/api/v1/repos/itdlabs/cix-build-system/archive/v0.1.27.tar.gz"
            sha256 "6ea06abbe0672aa5fd1c1177ac6d10c7b53de641d055b67f37de5965479cc035"
        }
        # zstd 1.5.4, for upstream-test. Declared as a source so the
        # daemon fetches and checksum-verifies it host-side; never
        # fetched from inside the build.
        extra "zstd" {
            url "https://github.com/facebook/zstd/archive/refs/tags/v1.5.4.tar.gz"
            sha256 "35ad983197f8f8eb0c963877bf8be50490a0b3df54b4edeb8399ba8a8b2f60a4"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "bash"
            tool "coreutils"
            tool "grep"
            tool "sed"
            tool "gawk"
            tool "binutils"
            tool "findutils"
            tool "diffutils"
            tool "tar"
            tool "gzip"
            # curl, for libcurl.so.4. CBS dlopen()s it to fetch, and
            # tests/cli-build-test.sh serves a source over a local
            # http-server and has cbs fetch it -- so the suite needs the
            # library even though nothing here reaches the network.
            #
            # Dropped by the first draft of this translation, and the
            # build caught it: `make test` ran the recipe corpus, 50
            # parser cases, the metadata test and the upstream smoke
            # test, then failed in cli-build-test.sh. A declaration
            # system earning its keep on its own recipe.
            tool "curl"
            tool "libarchive"
            tool "zstd"
            tool "linux-headers"
        }
        runtime {
            package "libarchive"
            package "zstd"
        }
    }

    metadata {
        "changelog" "v0.1.27-1: the first cbs revision since v0.1.23 that can name a TAG -- VERSION has moved past it, so the binary reports what its source tree declares (cix-build-system#172). Adds the five CPDL shapes the recipe corpus was blocked on: each with a compound body (#176), replace from a prefix until a delimiter (#177), stage library (#178), require file target for symlinks (#175), and lowercase environment names for autoconf cache variables (#179). Also #174."
    }

    prepare {
        #
        # Every source extracts into ${src}/<source-name>/, main
        # included -- cbs_prepare_sources_with_events() mkdirs
        # "<source_root>/<source->name>" for each and extracts there,
        # preserving the archive's own top-level directory. Note two of
        # the three recipes upstream ships omit that segment and would
        # not build; their recipe-test only validates.
        #
        # Listed before it is required so that the log answers what the
        # gitea archive's top-level directory is actually called, rather
        # than only whether one guess was right. This sandbox compiles
        # and unpacks nothing, so the box is the only place that can
        # answer it, and one build cycle is the price of that rule.
        #
        run "ls" {
            "-la"
            "${src}/cbs"
        }
        require directory "${src}/cbs/cix-build-system" {
            exists
        }
        #
        # The zstd deprecation define, appended to the Makefile rather
        # than passed on the command line.
        #
        # This is the shell recipe's hardest-won detail and the reason
        # this phase exists at all. A make command-line assignment has
        # the highest precedence of all and cannot be appended to, so
        # passing CPPFLAGS there silently discards the Makefile's own
        #
        #   CPPFLAGS += -DCBS_VERSION=\"$(CBS_VERSION)\"
        #
        # and src/main.c falls through to `#define CBS_VERSION
        # "unknown"`. That is why `cbs --version` said `cbs unknown`
        # through revisions -3 to -7 of the shell recipe: the version
        # was being computed and thrown away.
        #
        # Anchored on the CBS_VERSION line, and `exactly 1`, so that if
        # upstream moves or renames it the edit fails loudly here
        # rather than producing a binary that builds and reports the
        # wrong version. The shell recipe relies on a sed that matches
        # nothing failing later at zstd.h; CPDL can simply insist.
        #
        replace "${src}/cbs/cix-build-system/Makefile" {
            from "CPPFLAGS += -DCBS_VERSION=\\\"$(CBS_VERSION)\\\""
            to "CPPFLAGS += -DCBS_VERSION=\\\"$(CBS_VERSION)\\\"\nCPPFLAGS += -DZSTD_DISABLE_DEPRECATE_WARNINGS"
            exactly 1
        }
    }

    build {
        # CC=tcc explicitly, never a bare cc: the build sandbox's
        # default compiler has silently become real GCC before (#109),
        # and a build system compiled by the wrong compiler is the least
        # useful place for that to go unnoticed.
        cd "${src}/cbs/cix-build-system" {
            run "make" {
                env "CC" = "tcc"
                jobs $jobs
            }
        }
    }

    check {
        # ONE HYPOTHESIS, TESTED AS AN ASSERTION. Diagnostic revision.
        #
        # Measured so far, on this host in this image:
        #
        #   -1  `make test` -- everything PASSes except
        #       ./tests/archive-test, which printed NOTHING and took
        #       make down with Error 1.
        #   -2  `make tests/archive-test` -- not a real target. make
        #       fell back to a builtin rule and linked the test alone.
        #       This recipe's error, not upstream's.
        #   -3  the Makefile's own link line (Makefile:127), run
        #       standalone BEFORE `make test` -- PASSED: "archive
        #       extraction tests: PASS (safe links, mtimes, implicit
        #       parents, deferred directory modes, hostile entries, and
        #       named diagnostics)". The identical link and run then
        #       failed inside `make test` eighty lines later.
        #
        # Same binary, same container, same command line: passes
        # standalone, fails under make. The one difference this recipe
        # introduces is TMPDIR -- the `make test` run sets TMPDIR=/run
        # because these images have no /tmp, and the standalone run set
        # nothing.
        #
        # So the standalone run below now sets TMPDIR=/run and is a
        # real assertion rather than a diagnostic. If it fails, TMPDIR
        # is the differentiator and the answer is in hand. If it passes
        # and `make test` still fails, the cause is something else and
        # the on_fail block says what the two temp roots looked like.
        cd "${src}/cbs/cix-build-system" {
            run "tcc" {
                "-Isrc"
                "-DCBS_VERSION=\"0.1.26\""
                "-DZSTD_DISABLE_DEPRECATE_WARNINGS"
                "-std=c11"
                "-Wall"
                "-Wextra"
                "-Werror"
                "-pedantic"
                "tests/archive-test.c"
                "src/archive.o"
                "src/ast.o"
                "src/diag.o"
                "-larchive"
                "-o"
                "tests/archive-test"
            }
            run "./tests/archive-test" {
                env "TMPDIR" = "/run"
            }
            run "make" {
                "test"
                env "CC" = "tcc"
                env "CBS_UPSTREAM_CACHE" = "/build/cbscache"
                env "TMPDIR" = "/run"
                jobs $jobs
            }
            run "./cbs" {
                "--version"
            }
            # Diagnostics, run only if something above failed. This is
            # what on_fail is for, and allow_failure is valid only here.
            on_fail {
                run "ls" {
                    "-la"
                    "/run"
                    allow_failure
                }
                run "ls" {
                    "-la"
                    "/tmp"
                    allow_failure
                }
            }
        }
    }

    install {
        mkdir "${dest}/usr/bin" chmod 0755
        copy "${src}/cbs/cix-build-system/cbs" to "${dest}/usr/bin/cbs"
        require file "${dest}/usr/bin/cbs" {
            exists
        }
    }
}
