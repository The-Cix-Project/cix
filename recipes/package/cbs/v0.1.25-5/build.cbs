# v5: release 4 failed, and it was this recipe's fault rather than
# upstream's. It passed CBS_VERSION="0.1.25+13.g170dc744", and one of
# the tests that arrived in these same thirteen commits,
# tests/cli-build-test.sh, asserts the version's FORMAT:
#
#   printf '%s\n' "$version_output" | grep -Eq '^cbs [0-9][0-9A-Za-z._-]*$'
#
# There is no `+` in that character class, so `set -eu` ended the
# script on its third assertion and `make test` failed with the build
# otherwise entirely clean -- every object compiled, the link
# succeeded, and the smoke, corpus, parser and metadata tests all
# passed. Verified the mismatch directly against that regex rather
# than inferred from the silence: the script's failing assertions are
# all `test` and `grep -q`, so it printed nothing at all, which is
# what made an early exit look like a mysterious one.
#
# `-` IS in the class, so the version is now 0.1.25-13.g170dc744 --
# still truthful about the tree, and inside the format upstream's own
# tests define. Not reported upstream: semver puts build metadata
# after a `+` and their regex arguably should allow it, but a ticket
# asking for a character when a permitted one says the same thing is
# noise.
#
# cbs v0.1.25 release 5 -- built from main at 170dc744d, thirteen
# commits past the v0.1.25 tag, because every upstream gap Cix filed
# was closed in those commits and none of them is in a release yet.
#
# Why a commit and not a tag. Upstream has not tagged since v0.1.25
# and `VERSION` on main still reads 0.1.25, so there is no upstream
# version string for this tree. Asked for as
# cix-build-system#172 -- as a request, not a blocker: a commit
# archive fetches through the ordinary pkg_source path (HTTP 200,
# 326458 bytes), its bytes pin with sha256 exactly as a tag's do, and
# its top-level directory is `cix-build-system/` just like a tag's, so
# the extraction path below is unchanged. I first filed that issue
# claiming Cix could not consume main at all, which was invented --
# there is no gate.
#
# The release digit carries it. A Cix package is <version>-<release>,
# so this is a name that has never existed and collides with nothing.
#
# CBS_VERSION is passed explicitly so the binary does not claim to be
# the v0.1.25 release when it is thirteen commits past it. Makefile:4
# is `CBS_VERSION ?= $(shell sed -n '1p' VERSION ...)`, and `?=`
# yields to the environment, so this needs no patch -- unlike
# CPPFLAGS, where a make command-line assignment silently discarded
# the Makefile's own append and is why revisions -3 through -7 of the
# shell recipe reported `cbs unknown`.
#
# What these thirteen commits give Cix, each verified in the tree on
# main rather than taken from a commit message:
#
#   --finalize-command CMD   a process-level finalize seam, failing
#                            the build closed on a non-zero exit
#                            (#159) -- unblocks CIXPKG as the artifact
#                            format
#   metadata { "k" "v" }     an opaque, embedder-owned block reported
#                            by explain --json (#161) -- unblocks the
#                            .cbs becoming the only recipe file, since
#                            pkg_artifact_sha256 finally has a home
#   "capabilities": [...]    names instead of a count (#162) -- lets a
#                            recipe declaring CAP_SYS_ADMIN be built
#                            rather than refused
#   --prune-policy FILE      a declared, reportable prune (#169)
#   license "..."            recorded in CIXPKG (#168)
#   --firmware-root DIR      kernel executor context (#171)
#   glob source edits (#165), list forms (#166), archive mtimes
#   preserved (#167), pre-build failures diagnosed (#163), and the
#   untested recipe seed set retired (#170)
#
#
# cbs, built by cbs (ADR-0305, stage 2).
#
# This is the self-hosting step: the build system's own recipe, written
# in the language the build system reads. Stage 1 proved cixd can
# publish and build a CPDL recipe at all (probe-pbs 2-1); this one
# proves the thing worth proving, which is that the engine can build
# itself.
#
# Revision 3: the -2 draft omitted `curl` from the build
# declaration and the suite failed in cli-build-test.sh, which
# fetches over the libcurl CBS dlopen()s. Restored.
#
# It is a translation of recipes/package/cbs/v0.1.25-1/build.sh, not a
# fresh design, and deliberately so -- the shell revision is a real,
# working recipe with hard-won details in it, and a rewrite that
# quietly dropped one of them would look like a success. Each detail is
# carried over and noted below.
#
# NOT taken from cix-build-system's own cbs.cbs. That file is upstream's
# fixture: it declares a placeholder digest, it is what their
# recipe-metadata test reads, and building from it would mean shipping a
# package whose source pin is someone else's test data.
#
# The offline test cache is the one part with no equivalent in the
# shell recipe, because it needs none there. 0.1.25's `make test`
# includes upstream-test, which builds recipes/zstd.cbs and therefore
# FETCHES -- in a container with no network. upstream-smoke-test.sh
# honours CBS_UPSTREAM_CACHE and copies its files into the cache it
# hands cbs, and cixd already stages every declared source at
# /build/cbscache/<sha256> for a PBS build, which is precisely the
# digest-named layout CBS looks for. So the cache is pointed straight
# at cixd's own handoff directory: nothing is copied, nothing is
# invented, and the zstd tarball is fetched and verified host-side by
# the daemon exactly like any other source.
package "cbs" {
    version "v0.1.25"
    release 5
    format "cixpkg"

    sources {
        main "cbs" {
            url "https://osakka:{{REPO_TOKEN}}@git.home.arpa/api/v1/repos/itdlabs/cix-build-system/archive/170dc744d.tar.gz"
            sha256 "27cea3ff622a314c031470784f600af13d7f6607fc77d4686b3c59eca0c7cd6a"
        }
        # zstd 1.5.4, for upstream-test. Declared as a source so the
        # daemon fetches and checksum-verifies it host-side; never
        # fetched from inside the build.
        extra "zstd" {
            url "https://github.com/facebook/zstd/archive/refs/tags/v1.5.4.tar.gz"
            sha256 "35ad983197f8f8eb0c963877bf8be50490a0b3df54b4edeb8399ba8a8b2f60a4"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "bash"
            tool "coreutils"
            tool "grep"
            tool "sed"
            tool "gawk"
            tool "binutils"
            tool "findutils"
            tool "diffutils"
            tool "tar"
            tool "gzip"
            # curl, for libcurl.so.4. CBS dlopen()s it to fetch, and
            # tests/cli-build-test.sh serves a source over a local
            # http-server and has cbs fetch it -- so the suite needs the
            # library even though nothing here reaches the network.
            #
            # Dropped by the first draft of this translation, and the
            # build caught it: `make test` ran the recipe corpus, 50
            # parser cases, the metadata test and the upstream smoke
            # test, then failed in cli-build-test.sh. A declaration
            # system earning its keep on its own recipe.
            tool "curl"
            tool "libarchive"
            tool "zstd"
            tool "linux-headers"
        }
        runtime {
            package "libarchive"
            package "zstd"
        }
    }

    prepare {
        #
        # Every source extracts into ${src}/<source-name>/, main
        # included -- cbs_prepare_sources_with_events() mkdirs
        # "<source_root>/<source->name>" for each and extracts there,
        # preserving the archive's own top-level directory. Note two of
        # the three recipes upstream ships omit that segment and would
        # not build; their recipe-test only validates.
        #
        # Listed before it is required so that the log answers what the
        # gitea archive's top-level directory is actually called, rather
        # than only whether one guess was right. This sandbox compiles
        # and unpacks nothing, so the box is the only place that can
        # answer it, and one build cycle is the price of that rule.
        #
        run "ls" {
            "-la"
            "${src}/cbs"
        }
        require directory "${src}/cbs/cix-build-system" {
            exists
        }
        #
        # The zstd deprecation define, appended to the Makefile rather
        # than passed on the command line.
        #
        # This is the shell recipe's hardest-won detail and the reason
        # this phase exists at all. A make command-line assignment has
        # the highest precedence of all and cannot be appended to, so
        # passing CPPFLAGS there silently discards the Makefile's own
        #
        #   CPPFLAGS += -DCBS_VERSION=\"$(CBS_VERSION)\"
        #
        # and src/main.c falls through to `#define CBS_VERSION
        # "unknown"`. That is why `cbs --version` said `cbs unknown`
        # through revisions -3 to -7 of the shell recipe: the version
        # was being computed and thrown away.
        #
        # Anchored on the CBS_VERSION line, and `exactly 1`, so that if
        # upstream moves or renames it the edit fails loudly here
        # rather than producing a binary that builds and reports the
        # wrong version. The shell recipe relies on a sed that matches
        # nothing failing later at zstd.h; CPDL can simply insist.
        #
        replace "${src}/cbs/cix-build-system/Makefile" {
            from "CPPFLAGS += -DCBS_VERSION=\\\"$(CBS_VERSION)\\\""
            to "CPPFLAGS += -DCBS_VERSION=\\\"$(CBS_VERSION)\\\"\nCPPFLAGS += -DZSTD_DISABLE_DEPRECATE_WARNINGS"
            exactly 1
        }
    }

    build {
        # CC=tcc explicitly, never a bare cc: the build sandbox's
        # default compiler has silently become real GCC before (#109),
        # and a build system compiled by the wrong compiler is the least
        # useful place for that to go unnoticed.
        cd "${src}/cbs/cix-build-system" {
            run "make" {
                env "CC" = "tcc"
                env "CBS_VERSION" = "0.1.25-13.g170dc744"
                jobs $jobs
            }
        }
    }

    check {
        # The whole upstream suite, as a real gate. The shell recipe
        # made it fatal deliberately (its earlier revisions only
        # reported it, because it could not run on this platform at
        # all) and that stays true here.
        cd "${src}/cbs/cix-build-system" {
            run "make" {
                "test"
                env "CC" = "tcc"
                env "CBS_VERSION" = "0.1.25-13.g170dc744"
                env "CBS_UPSTREAM_CACHE" = "/build/cbscache"
                env "TMPDIR" = "/run"
                jobs $jobs
            }
            # It runs, and it knows its own version -- the #109 trap
            # above, checked rather than assumed.
            run "./cbs" {
                "--version"
            }
        }
    }

    install {
        mkdir "${dest}/usr/bin" chmod 0755
        copy "${src}/cbs/cix-build-system/cbs" to "${dest}/usr/bin/cbs"
        require file "${dest}/usr/bin/cbs" {
            exists
        }
    }
}
