# bc, as a PBS recipe (ADR-0305 stage 4).
#
# A translation of the previous build.sh: same tarball at the same
# digest, the same configure invocation, the same `make install`.
#
# The shell recipe deleted usr/share/{man,info}; ADR-0306 withdrew that practice (#491) and those lines are gone.
package "bc" {
    version "1.08.1"
    release 4
    format "cixpkg"

    license "GPL-3.0-or-later"

    sources {
        main "bc" {
            url "https://ftp.gnu.org/gnu/bc/bc-1.08.1.tar.gz"
            sha256 "b71457ffeb210d7ea61825ff72b3e49dc8f2c1a04102bbe23591d783d1bfe996"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
        }
    }

    metadata {
        "artifact_sha256" "ee3a41c0ac12a43b1f7e994e56c037a76eb874f4fc2c35b46cee8c54ec66c608"
        "changelog" "1.08.1-4: converted from build.sh to build.cbs (ADR-0305 stage 4). Same tarball at the same digest and the same configure invocation. Stops deleting its own documentation (ADR-0306, #491)."
    }

    prepare {
        run "ls" {
            "-la"
            "${src}/bc"
        }
        require directory "${src}/bc/bc-1.08.1" {
            exists
        }
    }

    build {
        cd "${src}/bc/bc-1.08.1" {
            run "./configure" {
                "--prefix=/usr"
                env "CC" = "tcc"
            }
            run "make" {
                "MAKEINFO=true"
                jobs $jobs
            }
        }
    }

    install {
        cd "${src}/bc/bc-1.08.1" {
            run "make" {
                "install"
                "DESTDIR=${dest}"
                "MAKEINFO=true"
            }
        }
        require file "${dest}/usr/bin/bc" {
            exists
            nonempty
        }
    }
}
