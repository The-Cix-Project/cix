# sed, as a PBS recipe (ADR-0305 stage 4).
#
# A translation of recipes/package/sed/4.9-5/build.sh: same tarball at
# the same digest, the same weak __dso_handle stub, the same configure
# and `make install`. See recipes/package/grep/3.11-7/build.cbs for why
# the stub exists and why `$(pwd)` needs no equivalent.
#
# As there, the shell recipe's `rm -rf "$PKG_DESTDIR/usr/lib"/*.a` is
# not translated: sed installs no library, so it matched nothing, and
# CPDL's `remove glob` fails on a glob that matches nothing rather than
# shrugging the way `rm -f` does.
package "sed" {
    version "4.9"
    release 6
    format "cixpkg"

    license "GPL-3.0-or-later"

    sources {
        main "sed" {
            url "https://ftp.gnu.org/gnu/sed/sed-4.9.tar.gz"
            sha256 "d1478a18f033a73ac16822901f6533d30b6be561bcbce46ffd7abce93602282e"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
        }
    }

    metadata {
        "artifact_sha256" "9f7f59395ecc7f46f3abd06dda6d77b1efe5bdf594a91d439b9a3beebce32146"
        "changelog" "4.9-6: converted from build.sh to build.cbs (ADR-0305 stage 4). Same tarball at the same digest, the same weak __dso_handle stub, and the same gnulib _GL_EXTERN_INLINE_STDHEADER_BUG define TCC needs. Stops deleting usr/share/{man,info,locale} (ADR-0306, #491). The defensive rm of usr/lib/*.a is not translated: sed installs no library, and remove glob fails on a glob matching nothing."
    }

    prepare {
        run "ls" {
            "-la"
            "${src}/sed"
        }
        require directory "${src}/sed/sed-4.9" {
            exists
        }
        write "${src}/sed/sed-4.9/dso_stub.c" "void *__dso_handle __attribute__((weak)) = (void *)0;\n"
    }

    build {
        cd "${src}/sed/sed-4.9" {
            run "tcc" {
                "-c"
                "dso_stub.c"
                "-o"
                "dso_stub.o"
            }
            run "./configure" {
                "--prefix=/usr"
                "LIBS=${src}/sed/sed-4.9/dso_stub.o"
                env "CC" = "tcc"
                env "CFLAGS" = "-D_GL_EXTERN_INLINE_STDHEADER_BUG=1"
            }
            run "make" {
                "MAKEINFO=true"
                jobs $jobs
            }
        }
    }

    install {
        cd "${src}/sed/sed-4.9" {
            run "make" {
                "install"
                "DESTDIR=${dest}"
                "MAKEINFO=true"
            }
        }
        require file "${dest}/usr/bin/sed" {
            exists
            nonempty
        }
    }
}
