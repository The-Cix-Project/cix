# wget, as a PBS recipe (ADR-0305 stage 4).
#
# A translation of recipes/package/wget/1.25.0/build.sh: same tarball at
# the same digest, the same eleven configure switches, the same `make
# install`.
#
# Release 2, not 1, and the reason is a trap worth knowing about.
#
# The shell revision is `1.25.0` with no release suffix. CPDL requires
# `version` and `release` separately, so the obvious conversion is
# `version "1.25.0" release 1` -- which fuses to the recipe version
# `1.25.0-1` and, crucially, to the ARTIFACT name
# `wget-1.25.0-1-x86_64.tar.gz`. That is the identical artifact name a
# suffix-less shell version already publishes under, because a missing
# release is published as release 1.
#
# So the two recipe versions are distinct and their artifacts are not.
# Installing `1.25.0-1` found the shell recipe's artifact already in the
# cache, downloaded it, installed it, and reported success at the PBS
# version -- the recipe never ran. It was caught only by noticing the
# cache entry was dated five days earlier than the build (cix#494).
#
# Release 2 cannot alias anything. Any conversion of a suffix-less shell
# version needs the same care.
#
# `rm -rf usr/share` is gone (ADR-0306, #491). `rm -rf usr/etc` is NOT
# a documentation removal -- wget's configure installs a system wgetrc
# under the prefix, and the recipe has always dropped it rather than
# ship a config file nothing reads. Kept, as `remove tree`.
package "wget" {
    version "1.25.0"
    release 2
    format "cixpkg"

    license "GPL-3.0-or-later"

    sources {
        main "wget" {
            url "https://mirrors.kernel.org/gnu/wget/wget-1.25.0.tar.gz"
            sha256 "766e48423e79359ea31e41db9e5c289675947a7fcf2efdcedb726ac9d0da3784"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
            tool "findutils"
            tool "diffutils"
            tool "pkgconf"
            tool "openssl"
            tool "zlib"
        }
        runtime {
            package "openssl"
            package "zlib"
        }
    }

    metadata {
        "artifact_sha256" "c695ef1254f07822fa5f6c05d3e0c3e7cfaa8e849457f0a5b6a34b6b4b3930ab"
        "changelog" "1.25.0-2: converted from build.sh to build.cbs (ADR-0305 stage 4). Same tarball at the same digest and the same configure switches, including the gnulib _GL_EXTERN_INLINE_STDHEADER_BUG define TCC needs. Release 2 rather than 1 because the shell version has no release suffix and so already publishes as wget-1.25.0-1, which release 1 would have aliased -- the install then takes the old artifact and reports success (cix#494). Stops deleting usr/share (ADR-0306, #491); still drops usr/etc."
    }

    prepare {
        run "ls" {
            "-la"
            "${src}/wget"
        }
        require directory "${src}/wget/wget-1.25.0" {
            exists
        }
    }

    build {
        # CFLAGS carries _GL_EXTERN_INLINE_STDHEADER_BUG=1, and it is
        # load-bearing. gnulib picks its inline linkage from
        # __STDC_VERSION__ when __GNUC__ is undefined, and TCC reports
        # C99 without implementing C99 inline the way gnulib expects --
        # so every translation unit emits its own strong definition of
        # each helper and the final link fails with dozens of "defined
        # twice". This define is gnulib's OWN escape hatch for a
        # compiler with that bug, and selects its `static` fallback.
        #
        # AR and RANLIB are named explicitly because configure's probe
        # for them is not reliable in this sandbox.
        cd "${src}/wget/wget-1.25.0" {
            run "./configure" {
                "--prefix=/usr"
                "--with-ssl=openssl"
                "--with-zlib"
                "--without-libpsl"
                "--without-libidn"
                "--without-metalink"
                "--without-libcares"
                "--without-libpcre"
                "--without-libpcre2"
                "--disable-iri"
                "--disable-nls"
                "--disable-rpath"
                env "CC" = "tcc"
                env "AR" = "ar"
                env "RANLIB" = "ranlib"
                env "CFLAGS" = "-D_GL_EXTERN_INLINE_STDHEADER_BUG=1"
            }
            run "make" {
                jobs $jobs
            }
        }
    }

    install {
        cd "${src}/wget/wget-1.25.0" {
            run "make" {
                "install"
                "DESTDIR=${dest}"
            }
        }
        remove tree "${dest}/usr/etc"
        require file "${dest}/usr/bin/wget" {
            exists
            nonempty
        }
    }
}
