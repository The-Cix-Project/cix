# probe-approve-pbs 2 -- THE RESULT, against release 1's control.
#
# Identical to 1-1 except that it declares a `metadata { }` block. If
# an `artifact_sha256` appears in THIS recipe after its artifact is
# pushed and in 1-1 it does not, the block is what the daemon needed
# and the writer works (#492).
#
# What must ALSO be true, and is the half that is easy to miss:
# parse_pbs_recipe() reads the derived explain.json beside the recipe,
# never the recipe itself (ADR-0305). So an approval written only into
# the .cbs would be invisible to every build -- the recipe would say
# approved and the pipeline would rebuild from source forever. The
# writer refreshes both, recipe first, and the check is that
# `GET /v1/pkg` reports this package taking a cache hit on a second
# install rather than building again.
#
# EXPECTED RESULT: install succeeds; the recipe gains
# `        "artifact_sha256" "<64 hex>"` inside its metadata block; and
# the explain.json beside it carries the same value.
#
#
# The control's own header follows, for the contrast:
# probe-approve-pbs 1 -- THE CONTROL. A PBS recipe with NO
# `metadata { }` block, so its published artifact cannot be approved
# (#492).
#
# The daemon can write an artifact approval into a build.cbs from cix
# v2.57.220, and it writes it into an existing `metadata { }` block.
# It does not CREATE one: that would mean choosing a position in a
# document cixd deliberately does not parse, CPDL fixes its
# declaration order (CPDL-E3003), and getting it wrong produces an
# invalid recipe. So a recipe without a block is left untouched and
# the daemon says so, once, at the moment the approval would have
# happened.
#
# EXPECTED RESULT: the install SUCCEEDS, the artifact is pushed to the
# cache, and the recipe is NOT modified -- `GET
# /v1/pkg/recipes/probe-approve-pbs?version=1` contains no
# artifact_sha256. The log carries an info line naming the three lines
# to add.
#
# Version 2 is the same recipe WITH the block, so the difference
# between the two is attributable to the block and nothing else.
package "probe-approve-pbs" {
    version "1"
    release 2
    format "cixpkg"

    sources {
        main "cixsrc" {
            url "https://osakka:{{REPO_TOKEN}}@git.home.arpa/api/v1/repos/itdlabs/cix/archive/v2.57.219.tar.gz"
            sha256 "d4c2727bb495dfcf63f1b82157183794cf95957abca6c351baff6979d5949d0d"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "bash"
            tool "coreutils"
        }
    }

    metadata {
        "changelog" "1-2: the WITH-BLOCK case for #492. Identical to 1-1 except for this block, so an artifact_sha256 appearing here is attributable to it."
    }

    install {
        mkdir "${dest}/usr/share/probe-approve-pbs"
        write "${dest}/usr/share/probe-approve-pbs/approved.txt" "metadata block present: approval must be written\n"
        require file "${dest}/usr/share/probe-approve-pbs/approved.txt" {
            exists
        }
    }
}
