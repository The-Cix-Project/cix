# bash -- the GNU Bourne-Again SHell. Converted from build.sh to
# build.cbs (ADR-0305 stage 4, #487).
#
# NOTHING IS RESTORED BY THIS RECIPE under #491, and the artifact
# still grows: this recipe never deleted anything, so the
# usr/share/{doc,info,locale,man} that returns is returned by the
# finalize policy no longer removing it (ADR-0306), not by an edit
# here. Worth stating because "no diff in the install phase" and "no
# change in the artifact" are different claims.
#
# /bin/sh is the one thing this recipe does beyond make install, and
# it is load-bearing for every OTHER package's build. This project's
# images have no /bin at all, and glibc's popen() and system() are
# specified to exec "/bin/sh" literally with no override -- not
# $SHELL, not a SHELL= make variable. The kernel's own
# scripts/kconfig/preprocess.c calls popen() to evaluate Kconfig's
# $(shell ...) macros, and without this link that call fails deep in
# glibc's posix_spawn fast path and surfaces as ENOMEM rather than
# ENOENT (ADR-0056).
#
# No readline dependency: bash builds its bundled lib/readline copy
# when it finds no suitable external one, and takes an external one
# when the build image has it. Either is fine here, which is why
# there is no --with/--without flag.
package "bash" {
    version "5.2.37"
    release 6
    format "cixpkg"

    sources {
        main "bash" {
            url "https://ftp.gnu.org/gnu/bash/bash-5.2.37.tar.gz"
            sha256 "9599b22ecd1d5787ad7d3b7bf0c59f312b3396d1e281175dd1f8a4014da621ff"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
        }
    }

    metadata {
        "artifact_sha256" "822bd9af49c83a7b0034bcbbcc78935d0f8739712f302d95a85cb3806103d5f9"
        "changelog" "5.2.37-6: converted from build.sh to build.cbs (ADR-0305 stage 4) and published as a .cixpkg (ADR-0307). Same tarball at the same digest and the same configure line. The artifact gains usr/share/{doc,info,locale,man} under ADR-0306/#491, but not by any edit here -- this recipe never deleted them; the finalize policy did."
    }

    build {
        cd "${src}/bash/bash-5.2.37" {
            run "./configure" {
                "--prefix=/usr"
                env "CC" = "tcc"
            }
            run "make" {
                jobs $jobs
            }
        }
    }

    install {
        cd "${src}/bash/bash-5.2.37" {
            run "make" {
                "install"
                "DESTDIR=${dest}"
            }
        }
        mkdir "${dest}/bin" chmod 0755
        symlink "/usr/bin/bash" to "${dest}/bin/sh"
        require file "${dest}/usr/bin/bash" {
            exists
            nonempty
        }
    }
}
