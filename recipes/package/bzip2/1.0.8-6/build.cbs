# bzip2, as a PBS recipe (ADR-0305 stage 4).
#
# A translation of recipes/package/bzip2/1.0.8-5/build.sh: same tarball
# at the same digest, the same shared-library Makefile, the same five
# installed paths.
#
# bzip2 is the first conversion in this corpus to need `symlink`, and
# the operand order is worth stating because it is the opposite of
# `ln -s`'s reading in prose: CPDL is `symlink TARGET to LINKPATH`, and
# cbs calls symlink(target, linkpath) with them in that order. The
# targets here are deliberately RELATIVE ("libbz2.so.1.0.8", not
# "${dest}/usr/lib/..."), because a symlink inside a package tree must
# resolve on the installed host, where ${dest} does not exist.
package "bzip2" {
    version "1.0.8"
    release 6
    format "cixpkg"

    license "bzip2-1.0.6"

    sources {
        main "bzip2" {
            url "https://sourceware.org/pub/bzip2/bzip2-1.0.8.tar.gz"
            sha256 "ab5a03176ee106d3f0fa90e381da478ddae405918153cca248e682cd0c4a2269"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
            tool "findutils"
        }
    }

    metadata {
        "artifact_sha256" "dccc1dc9722864cdddb67a4f6d933595722af4524c579ccad261ad86e07cb1c7"
        "changelog" "1.0.8-6: converted from build.sh to build.cbs (ADR-0305 stage 4). Same tarball at the same digest and the same Makefile-libbz2_so build; the three symlinks the shell recipe made with ln -s are CPDL symlink operations with relative targets."
    }

    prepare {
        run "ls" {
            "-la"
            "${src}/bzip2"
        }
        require directory "${src}/bzip2/bzip2-1.0.8" {
            exists
        }
    }

    build {
        # `make clean` first, exactly as the shell recipe did: bzip2's
        # tarball ships prebuilt objects from the maintainer's own
        # machine, and Makefile-libbz2_so would happily link them.
        #
        # CC=tcc here is a make command-line OVERRIDE, not an
        # environment variable -- bzip2's Makefile assigns CC
        # unconditionally, so an env var would lose to it. That is the
        # same trap iputils' recipe records, and the reason this
        # recipe's two `run` blocks spell the compiler two different
        # ways is that the two Makefiles genuinely differ.
        cd "${src}/bzip2/bzip2-1.0.8" {
            run "make" {
                "clean"
            }
            run "make" {
                "-f"
                "Makefile-libbz2_so"
                "CC=tcc"
                jobs $jobs
            }
        }
    }

    install {
        mkdir "${dest}/usr/bin" chmod 0755
        mkdir "${dest}/usr/lib" chmod 0755
        mkdir "${dest}/usr/include" chmod 0755
        copy "${src}/bzip2/bzip2-1.0.8/bzip2-shared" to "${dest}/usr/bin/bzip2"
        copy "${src}/bzip2/bzip2-1.0.8/libbz2.so.1.0.8" to "${dest}/usr/lib/libbz2.so.1.0.8"
        copy "${src}/bzip2/bzip2-1.0.8/bzlib.h" to "${dest}/usr/include/bzlib.h"
        symlink "libbz2.so.1.0.8" to "${dest}/usr/lib/libbz2.so.1.0"
        symlink "libbz2.so.1.0.8" to "${dest}/usr/lib/libbz2.so"
        require file "${dest}/usr/bin/bzip2" {
            exists
            nonempty
        }
        require file "${dest}/usr/lib/libbz2.so.1.0.8" {
            exists
            nonempty
        }
        require file "${dest}/usr/include/bzlib.h" {
            exists
            nonempty
        }
    }
}
