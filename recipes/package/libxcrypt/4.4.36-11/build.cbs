# libxcrypt, as a PBS recipe (ADR-0305 stage 4).
#
# A translation of recipes/package/libxcrypt/4.4.36-10/build.sh: same
# tarball at the same digest, the same four configure switches, the same
# `make install`.
#
# The first gcc-built package converted, so it is also the first to
# carry CPDL's own toolchain declaration rather than the shell fields
# pkg_toolchain=/pkg_toolchain_reason= (ADR-0224, as amended by
# ADR-0226). The reason is carried over verbatim; it is a measurement
# with a date on it, not a verdict, and is worth re-measuring whenever
# the compiler changes.
package "libxcrypt" {
    version "4.4.36"
    release 11
    format "cixpkg"

    license "LGPL-2.1-or-later"

    sources {
        main "libxcrypt" {
            url "https://github.com/besser82/libxcrypt/releases/download/v4.4.36/libxcrypt-4.4.36.tar.xz"
            sha256 "e5e1f4caee0a01de2aee26e3138807d6d3ca2b8e67287966d1fefd65e1fd8943"
        }
    }

    requires {
        build {
            compiler "gcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
            tool "findutils"
            tool "diffutils"
            tool "perl"
            tool "pkgconf"
        }
    }

    toolchain "gcc" {
        reason "compiler identity check: the build requires __GNUC__, which TCC does not define"
    }

    metadata {
        "artifact_sha256" "4790514ec9e19834eac22896fe4757768ad4f6cc35ee916a1be21481cab5d40b"
        "changelog" "4.4.36-11: converted from build.sh to build.cbs (ADR-0305 stage 4). Same tarball at the same digest and the same configure switches. The gcc exception moves from pkg_toolchain=/pkg_toolchain_reason= to CPDL's own toolchain declaration, reason unchanged. Stops deleting usr/lib/*.la, which finalize already removes. The test -L on the libcrypt.pc symlink is dropped -- require file rejects a symlink (cix-build-system#175)."
    }

    prepare {
        run "ls" {
            "-la"
            "${src}/libxcrypt"
        }
        require directory "${src}/libxcrypt/libxcrypt-4.4.36" {
            exists
        }
    }

    build {
        # gcc by ABSOLUTE path, never a bare `gcc` resolved via $PATH:
        # a bare-name invocation makes gcc compute its own installation
        # prefix as a RELATIVE path, which then breaks cc1 with a
        # misleading "posix_spawnp: No such file or directory" that
        # reads like a missing file and is not one.
        cd "${src}/libxcrypt/libxcrypt-4.4.36" {
            run "./configure" {
                "--prefix=/usr"
                "--libdir=/usr/lib"
                "--disable-static"
                "--disable-obsolete-api"
                "--disable-werror"
                env "CC" = "/usr/bin/gcc"
            }
            run "make" {
                jobs $jobs
            }
        }
    }

    install {
        cd "${src}/libxcrypt/libxcrypt-4.4.36" {
            run "make" {
                "install"
                "DESTDIR=${dest}"
            }
        }
        # The shell recipe also asserted `test -L` on
        # usr/lib/pkgconfig/libcrypt.pc -- that it is a SYMLINK to
        # libxcrypt.pc, which is the whole point of the check. CPDL has
        # no way to assert on a link at all (cix-build-system#175), so
        # that assertion is simply gone rather than weakened into
        # something that would pass on a regular file and hide the case
        # it existed to catch.
        require file "${dest}/usr/lib/libcrypt.so.2.0.0" {
            exists
            nonempty
        }
        require file "${dest}/usr/lib/pkgconfig/libxcrypt.pc" {
            exists
            nonempty
        }
    }
}
