# libblkid -- block device identification, built standalone out of the
# util-linux tree. Converted from build.sh to build.cbs (ADR-0305
# stage 4, #487).
#
# WHAT CHANGES:
#
#   usr/share      -- no longer deleted (ADR-0306, #491). The shell
#                     recipe removed the whole tree, so what returns
#                     is whatever --disable-all-programs
#                     --enable-libblkid leaves there. The installed
#                     2.42.2-7 has 5 files and none under usr/share,
#                     so this may restore nothing at all; that is a
#                     prediction, and the file-for-file compare after
#                     the build is what settles it.
#   usr/lib/*.la   -- no longer deleted here. Finalize's clause 3
#                     drops a .la unconditionally.
#
# mkfs.btrfs uses this to spot an existing filesystem signature before
# formatting over it, and btrfs-progs' configure does
# PKG_CHECK_MODULES(BLKID) with no --disable flag, so there is no
# building btrfs-progs without it.
#
# libuuid is a BUILD input as well as a runtime one: a composed
# environment is built from the declared build tools alone, so libuuid
# has to be there as headers and a .pc to compile against, not merely
# installed alongside the result.
package "libblkid" {
    version "2.42.2"
    release 8
    format "cixpkg"

    sources {
        main "util-linux" {
            url "https://www.kernel.org/pub/linux/utils/util-linux/v2.42/util-linux-2.42.2.tar.xz"
            sha256 "03a05d3adf9602ef128f2da05b84b3205ce60c351e5737c0370f74000679ce8a"
        }
    }

    requires {
        build {
            compiler "gcc"
            tool "make"
            tool "bash"
            tool "coreutils"
            tool "linux-headers"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
            tool "pkgconf"
            tool "findutils"
            # cmp, which util-linux's configure and Makefile both use.
            # Its absence is what the #302 missing-command gate caught
            # on 2.42.2-6, and what had silently stopped -5 and
            # everything before it from building at all.
            tool "diffutils"
            tool "libuuid"
        }
        runtime {
            package "libuuid"
            package "pkgconf"
        }
    }

    # Tier 3, for a defect and not a preference. TCC does not
    # implement __builtin_clz and emits it as an ordinary undefined
    # external rather than failing, so 2.42.2-2 built, installed,
    # checksum-verified and shipped a BROKEN library -- `nm -D` showed
    # `U __builtin_clz`, and the first thing to link it died with
    # "undefined reference to `__builtin_clz'". kmod's configure
    # probes for the builtin and aborts, which is the loud version of
    # the same gap; util-linux never probes, so it got the silent one
    # (#176, #208).
    toolchain "gcc" {
        reason "codegen/correctness: TCC emits __builtin_clz as an undefined external instead of failing, so the .so built, installed, verified and was broken (#176, #208). Measured against tcc 0.9.27; #208 tracks fixing the compiler, and this is a candidate for re-measuring when it lands"
    }

    metadata {
        "artifact_sha256" "dd6b218f7db904e2648378482bac83e6d667047465e59980285b645f0c53be74"
        "changelog" "2.42.2-8: converted from build.sh to build.cbs (ADR-0305 stage 4) and published as a .cixpkg (ADR-0307). Same tarball at the same digest and the same configure line. Stops deleting usr/share (ADR-0306, #491) and the .la, which finalize removes anyway. The gcc reason now records which compiler it was measured against."
    }

    build {
        cd "${src}/util-linux/util-linux-2.42.2" {
            run "./configure" {
                "--prefix=/usr"
                "--libdir=/usr/lib"
                "--disable-all-programs"
                "--enable-libblkid"
                env "CC" = "/usr/bin/gcc"
            }
            run "make" {
                jobs $jobs
            }
        }
    }

    install {
        cd "${src}/util-linux/util-linux-2.42.2" {
            run "make" {
                "install"
                "DESTDIR=${dest}"
            }
        }
        # --libdir=/usr/lib is load-bearing and asserted here: without
        # it util-linux splits its output, putting the real
        # libblkid.so.1 in /lib and only the development symlink in
        # /usr/lib. The loader does not search a bare /lib on this
        # platform, so the split fails at the consumer rather than
        # here (#184).
        require file "${dest}/usr/lib/libblkid.so.1.1.0" {
            exists
            nonempty
        }
        require file "${dest}/usr/include/blkid/blkid.h" {
            exists
            nonempty
        }
        require file "${dest}/usr/lib/pkgconfig/blkid.pc" {
            exists
            nonempty
        }
    }
}
