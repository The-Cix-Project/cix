#
# openssl-dev -- libssl.so/libcrypto.so link-time dev symlinks (openssl's
# own headers are already staged wholesale by libc-dev.recipe's own
# "/usr/include/." copy, this project's own established "too fragile to
# hand-curate perfectly, stage the real complete tree" precedent -- no
# duplication needed here).
#
# Found as a real, genuine gap, not speculative: kanxeod has linked
# -lssl -lcrypto since Part 0.5 (the HTTPS listener, ADR-0059), but no
# recipe had ever staged the two dev symlinks a build needs to actually
# resolve those two -l flags -- undetected until this exact recipe set
# (Part 5's own REST-driven-ISO-assembly follow-on, ADR-0064) re-ran
# kanxeo.recipe's own self-hosted build for the first time since HTTPS
# landed, and hit a real, reproducible `tcc: error: library 'ssl' not
# found` on a fresh kanxeo-builder image with tcc+make+libc-dev+bash+
# coreutils (this project's own documented minimum set,
# docs/guides/building-kanxeo.md) -- confirmed the missing piece is
# exactly libssl.so/libcrypto.so (the runtime libcrypto.so.3 alone was
# already present via g_pkgbuild_rootfs's own wholesale toolchain
# staging; libssl.so.3 was missing entirely, and neither had the
# unversioned dev symlink `-lssl`/`-lcrypto` need to resolve at all).
#
# Building OpenSSL itself from source is real, substantial work of its
# own (a bespoke Configure script, not autoconf) and every other
# from-recipe image on this platform that needs libcrypto.so.3 at
# runtime (sbsigntools, this project's own PKI subsystem) already gets
# it via the existing wholesale-toolchain-copy convention -- the same
# "too complex to reasonably build here, stage the real pre-built host
# copy instead" call libc-dev.recipe already made for glibc. pkg_source
# below is the real, genuine openssl 3.0.20 upstream release -- the
# exact version this build host's own already-installed libssl-dev is
# (confirmed via `openssl version` and `dpkg -l libssl-dev`), fetched
# and checksum-verified against two independent sources (openssl.org's
# own /source/ tree and the openssl project's own GitHub release
# mirror) for real provenance, even though pkg_install() below copies
# the pre-built files directly from this build container's own
# toolchain-provided openssl (not built from this tarball -- see
# pkg_build()'s own comment, the identical shape libc-dev.recipe
# already established for the identical reason).
#
pkg_name="openssl-dev"
pkg_version="3.0.20"
pkg_source="https://www.openssl.org/source/openssl-3.0.20.tar.gz"
pkg_sha256="c80a01dfc70ece4dc21168932c37739042d404d46ccc81a5986dd75314ecda6f"
pkg_depends=""

# Deliberately not a real build -- see this recipe's own header comment
# for why. This step exists only to fail loudly if the fetched source's
# own version doesn't match what pkg_install() is about to copy from
# the toolchain sandbox's real libssl-dev, keeping the two in sync
# rather than silently drifting apart -- the same posture libc-dev.
# recipe's own pkg_build() already established.
pkg_build() {
	test -e /lib/x86_64-linux-gnu/libssl.so.3 -o -e /usr/lib/x86_64-linux-gnu/libssl.so.3 || {
		echo "no libssl.so.3 present anywhere on this build image -- update pkg_version/pkg_source above, or this build host's own toolchain no longer matches" >&2
		exit 1
	}
}

# Real files copied directly from this build container's own
# toolchain-provided openssl (confirmed present via the wholesale
# /usr/lib/x86_64-linux-gnu toolchain copy every other recipe's own
# build already relies on, the identical convention libc-dev.recipe's
# own pkg_install() uses) -- not built from the fetched tarball above.
# Destination is /lib/x86_64-linux-gnu (this project's own real
# runtime-library path, matching libc-dev.recipe's own reasoning for
# the identical choice) -- both the versioned runtime .so.3 (needed
# whether or not it happened to already be present) and the unversioned
# dev symlink `-lssl`/`-lcrypto` itself actually resolves against.
pkg_install() {
	mkdir -p "$PKG_DESTDIR/lib/x86_64-linux-gnu"
	for lib in libssl libcrypto; do
		src="/lib/x86_64-linux-gnu/$lib.so.3"
		test -e "$src" || src="/usr/lib/x86_64-linux-gnu/$lib.so.3"
		cp -a "$src" "$PKG_DESTDIR/lib/x86_64-linux-gnu/$lib.so.3"
		ln -s "$lib.so.3" "$PKG_DESTDIR/lib/x86_64-linux-gnu/$lib.so"
	done
}
