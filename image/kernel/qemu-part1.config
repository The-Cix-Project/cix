# Phase 11 part 1 kernel config fragment -- QEMU boot-test target only,
# not the real target hardware's eventual config (part 4).
#
# This is a merge-config fragment (kernel's own scripts/kconfig/merge_config.sh
# format), not a full .config -- reproduces deterministically against a
# specific kernel version starting from `make allnoconfig`, and stays
# readable/intentional instead of a ~60KB mostly-autogenerated file full of
# "# CONFIG_X is not set" noise. Every option here traces to a concrete
# requirement (see docs/roadmap/ROADMAP.md's Phase 11 part 1 section for the mapping
# to src/cgroup.c's actual memory.max/pids.max/cpu.max writes, etc.) rather
# than a distro-style "enable everything plausible" default.
#
# To reproduce against kernel 6.18.40 (or a later longterm release):
#   curl -sSL -o linux.tar.xz https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.18.40.tar.xz
#   tar xf linux.tar.xz && cd linux-6.18.40
#   make allnoconfig ARCH=x86_64
#   ./scripts/kconfig/merge_config.sh -m .config ../image/kernel/qemu-part1.config
#   make olddefconfig ARCH=x86_64
#   make -j$(nproc) ARCH=x86_64 bzImage
#   cp arch/x86/boot/bzImage <repo>/build/bzImage

# SMP: found missing during a real live investigation (ADR-0082) --
# `make allnoconfig`'s own starting point disables it, and this
# fragment never explicitly requested it, so every kernel built from
# this file up to this point ran strictly uniprocessor regardless of
# how many vCPUs the target VM was actually given: real, wasted
# capacity, not a cosmetic gap. Also the direct root cause of a second,
# previously-undiagnosed bug this same investigation traced to it:
# CONFIG_CPUSETS (init/Kconfig) itself has `depends on SMP`, so
# --cpuset= container creation could never have worked on any kernel
# built from this file, no matter what else got added to try to fix
# it (see ADR-0081's own, now-superseded-by-this-one root-cause guess).
CONFIG_SMP=y

# EFI: required for systemd-boot to chainload this kernel directly (the
# whole point of building with an EFI stub -- no separate initramfs/
# bootloader-within-a-bootloader). EFI itself depends on ACPI.
CONFIG_ACPI=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# Serial console: the only observable boot-proof mechanism for an
# automated, non-interactive QEMU test (test/test_boot.c scrapes this).
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y

# Unix98 PTYs (ADR-0042): image/src/thinc-install.c's own dual-console
# PTY relay (posix_openpt()/ptsname_r(), relaying fdisk's/mokutil's I/O
# across both /dev/tty0 and /dev/ttyS0 at once) needs this -- it's the
# one option gating the whole of fs/devpts/ in this kernel version (no
# separate CONFIG_DEVPTS_FS exists; confirmed against fs/devpts/Makefile).
# Not new to the actual built kernel this project has been testing
# against all along -- it was already =y via `make olddefconfig`'s own
# Kconfig-default resolution (not EXPERT-gated), just never explicit in
# this fragment until this feature gave it a real, named reason to be.
CONFIG_UNIX98_PTYS=y

# QEMU's virtual hardware -- Part 1's fixed/known "target" is QEMU itself,
# not real bare metal yet (that's part 4, with its own driver set).
CONFIG_PCI=y
CONFIG_BLK_DEV=y
CONFIG_NETDEVICES=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
# virtio-balloon (found live on 192.168.15.95, a real Proxmox/KVM guest,
# not bare metal despite "real install" elsewhere meaning "not a
# scripted QEMU test rig"): without this driver a KVM guest has no way
# to hand physical pages it's no longer using back to the host, so
# QEMU's own host-side RSS for the VM can only ever grow -- every page
# the guest kernel has EVER touched stays resident from the
# hypervisor's point of view even once the guest itself frees it
# internally. Confirmed directly: this guest's own /proc/meminfo-derived
# accounting (GET /v1/system/stats) showed a flat, tiny ~62MB "used"
# the whole time the *hypervisor's* own reported VM memory kept
# climbing -- there was never a real leak in thincd, the kernel, or
# any container, just nothing telling the host it could reclaim spare
# pages. CONFIG_VIRTIO_BALLOON_STATS_INTERVAL_DEFAULT isn't set here
# (0 = balloon still works, memory-usage *statistics* just aren't
# pushed to the host periodically -- not needed for actual reclaim).
CONFIG_VIRTIO_BALLOON=y

# Root filesystem: read-only squashfs image (ADR-0014), mounted directly
# by the kernel with no initramfs.
CONFIG_MISC_FILESYSTEMS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y

# ESP filesystem: thincd --init-mode mounts this (daemon/src/main.c's
# boot_init()) to reach the loader entry confirm_boot() renames once a
# boot proves healthy (Phase 11 part 2) -- not exercised until then, but
# added here rather than starting a second kernel config file, since
# it's the same kernel across every part of this phase.
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# Config/containers partitions (Phase 11 part 3) -- thinc-install formats
# these, thincd's own existing state-init machinery (network_init() etc.,
# daemon/src/main.c) populates them at first real boot without any new
# code, the same "fall through to unmodified existing logic" precedent
# parts 1-2 already established.
CONFIG_EXT4_FS=y

# OverlayFS -- src/overlay.c's overlay_create() mount("overlay", ...,
# "overlay", ...) for EVERY container this platform ever creates
# (CLAUDE.md's own Technology Stack: "the host OS is the shared
# lowerdir for all containers"). Missing here entirely until this exact
# point: `make allnoconfig` starts with everything off, and nothing in
# this fragment ever turned it back on, so every from-scratch kernel
# rebuild via this file's own documented recipe silently produced a
# kernel that could create every OTHER kind of container filesystem
# operation (image creation, plain directory writes) but failed
# mount(2) with ENODEV the moment any container was actually launched
# -- confirmed live on 192.168.15.95 (a pkg-build container's own
# overlay mount, root-caused via the exit-code-per-setup-step
# diagnostic this same investigation added to src/container.c/
# src/overlay.c/daemon/src/pkg.c). Almost certainly invisible for the
# whole rest of this project's history because build/bzImage is a
# separately-cached artifact (this file's own header comment already
# documents it's "not reproduced by make/make clean") built once, long
# ago, from a fuller config where overlay was already on, and then
# reused as-is across every ISO roll since -- this CONFIG_SWAP-driven
# rebuild (ADR-0069) was the first real regeneration from this exact
# fragment in a long time, the same "reused kernel artifact masked a
# tracked-config gap" pattern already seen once for CONFIG_SWAP itself.
CONFIG_OVERLAY_FS=y

# Installer ISO (Phase 11 part 4) -- thinc-install's own installer media
# boots via GRUB (an El Torito/UEFI-hybrid ISO built by hand-tuning
# xorriso proved genuinely fiddly; GRUB's grub-mkrescue is the standard,
# battle-tested tool every major distro uses for exactly this, real
# software rather than hand-rolling El Torito ourselves), and the kernel
# then mounts the ISO9660 media itself directly as root (no initramfs,
# same as every other root in this phase) -- needs the ATA/AHCI ->
# SCSI -> CD-ROM block-device stack (QEMU's -cdrom attaches via Q35's
# AHCI SATA controller as an ATAPI device) plus ISO9660 filesystem
# support.
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_SR=y
CONFIG_ISO9660_FS=y

# Part 3 (bare-metal-readiness plan) storage: kept BUILT-IN, not =m,
# for a real architectural reason confirmed against this project's own
# no-initramfs design (ADR-0014) -- the kernel mounts root directly,
# with no earlier stage able to modprobe anything first. Whichever
# controller a real target machine's root partition happens to live
# on must already be present at the moment the kernel tries to mount
# root, so it can't be a loadable module the way network/USB drivers
# below safely can (neither is ever needed to reach root in this
# project's model). CONFIG_SATA_AHCI above already had to be =y for
# exactly this reason (the installer ISO's own ATAPI CD-ROM); NVMe and
# software RAID join it here for the same reason, generalized to real
# target hardware whose root controller isn't known in advance.
CONFIG_BLK_DEV_NVME=y
CONFIG_BLK_DEV_MD=y
CONFIG_MD_RAID0=y
CONFIG_MD_RAID1=y
CONFIG_MD_RAID10=y
CONFIG_MD_RAID456=y
# The actual real-disk half of libata/AHCI above -- CONFIG_SATA_AHCI
# alone only gets the installer ISO's own ATAPI CD-ROM (CONFIG_BLK_DEV_SR)
# working; a real SATA/PATA/USB *disk* is presented through the SCSI
# midlayer (confirmed against this exact symbol's own Kconfig help
# text), so CONFIG_SCSI itself has to be =y here too, not =m --
# CONFIG_USB_STORAGE below still safely stays =m, since it only adds a
# new SCSI *transport*, not the disk driver itself, once this is
# already =y. A real gap until this line: earlier revisions of this
# file could install onto (and boot from) a VirtIO Block disk or the
# CD-ROM media itself, but not a real SATA/PATA hard disk at all --
# docs/guides/installing.md's own "Target disk" section is corrected
# alongside this.
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# Secure Boot (Phase 11 part 5, ADR-0015) -- thinc-install's own
# enroll_signing_key() needs /sys/firmware/efi/efivars to read/write the
# Mok* EFI variables (mokutil --import stages the enrollment request
# there; the installed system's own first boot, and every one after,
# reads it back to know the thinC key is trusted).
CONFIG_EFIVAR_FS=y

# devtmpfs: kernel auto-populates /dev before init runs -- thincd's own
# --init-mode boot_init() (daemon/src/main.c) never has to mknod anything.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Mounted by thincd --init-mode's boot_init() itself.
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y

# cgroup v2 controllers matching src/cgroup.c's actual writes
# (memory.max, pids.max, cpu.max), plus the device controller (Phase 12
# part 1, ADR-0017): cgroup v2 has no file-based devices.allow/deny the
# way v1 did -- BPF_CGROUP_DEVICE is the only kernel mechanism, so
# src/container_dev.c's container_dev_bpf_attach() needs a real bpf(2)
# syscall and CONFIG_CGROUP_BPF, not just CONFIG_CGROUPS.
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
# blk-cgroup + cgroup-aware writeback (found missing during the real
# issue #32/#46 gcc-bootstrap investigation, 2026-08-19): this
# fragment had CONFIG_MEMCG=y but no CONFIG_BLK_CGROUP=y, so writeback
# was never cgroup-isolated at all -- every dirty page across the
# WHOLE system funnels through one global/root bdi writeback path
# regardless of which cgroup dirtied it, a real, less-tested
# configuration than the cgroup-aware path most real distro kernels
# run with memcg+blkio enabled together. Confirmed as a real,
# concrete side effect first: GET /v1/containers/{name}/stats' own
# disk.read_bytes/write_bytes always read 0 for every real, actively-
# writing pkgbuild container this whole project's history -- there was
# never an io-cgroup controller compiled in to report through.
# Enabling it is real, load-bearing observability regardless of
# anything else; it's also the more heavily-exercised code path
# should this ever help avoid a repeat of a real kernel Oops (two
# independent page-cache/xarray faults in filemap_get_folios_tag, hit
# by jbd2 and a writeback kworker 23 seconds apart, both on the
# identical address) found live while diagnosing a stalled overnight
# gcc 12.5.0-4 bootstrap on 192.168.15.95 -- root cause not
# conclusively pinned down (this kernel has zero memory-debugging
# instrumentation compiled in, so a genuine xarray-corruption class of
# bug -- a real, recurring upstream issue historically hit by both XFS
# and shmem at various kernel versions -- can only ever surface this
# late and this confusingly, never at its actual origin), but this is
# a real, independently-justified hardening step either way.
# CONFIG_BLK_CGROUP selects CONFIG_BLK_DEV_THROTTLING's own
# prerequisites automatically; CONFIG_CGROUP_WRITEBACK is the actual
# symbol that wires memcg-aware dirty-page tracking through to the
# blkio controller (fs/fs-writeback.c's own inode_cgwb_enabled()
# check) -- both required together, confirmed against
# mm/Kconfig/block/Kconfig, not guessed.
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_WRITEBACK=y
# CONFIG_CGROUP_SCHED/CONFIG_FAIR_GROUP_SCHED above are NOT sufficient
# for cpu.max on their own -- confirmed the hard way (ADR-0165's own
# production regression investigation, ROADMAP Part 165): they only
# provide cpu.weight/cpu.weight.nice (proportional scheduling); the
# separate CFS_BANDWIDTH Kconfig symbol is what actually makes the
# cgroup v2 "cpu" controller expose a cpu.max file at all -- without
# it, cgroup_create()'s write_cgroup_file(dir, "cpu.max", ...) opens a
# file that genuinely doesn't exist (ENOENT), exactly as observed live
# on 192.168.15.95, the same class of previously-undiscovered kernel
# gap as CONFIG_INOTIFY_USER's own history (ADR-0113). memory.max/
# pids.max were never affected -- CONFIG_MEMCG/CONFIG_CGROUP_PIDS
# above are each independently complete for their own controller.
CONFIG_CFS_BANDWIDTH=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
# cpuset.cpus (Part 2 of the bare-metal-readiness plan, src/cgroup.c's
# cgroup_enable_cpuset()/cpuset_cpus) -- a distinct controller from
# CONFIG_CGROUP_SCHED above, which only covers cpu.max's bandwidth
# limiting, not which physical CPUs a cgroup's tasks may run on at all.
CONFIG_CPUSETS=y

# ext4 project quotas (Part 4 of the bare-metal-readiness plan,
# ADR-0062) -- daemon/src/main.c's own set_disk_quota() (a real
# quotactl(2) Q_SETQUOTA(PRJQUOTA) call) and src/overlay.c's own
# FS_IOC_FSSETXATTR project-id tagging both need real kernel-side
# quota support, not just the on-disk feature bit thinc-install.c's
# mkfs.ext4 -O quota now bakes in. CONFIG_QUOTA selects CONFIG_QUOTACTL
# itself (confirmed directly against the real kernel source's own
# fs/quota/Kconfig, not assumed) -- QUOTACTL has no separate prompt of
# its own and doesn't need setting here. CONFIG_QFMT_V2 (vfsv0/vfsv1
# quota file formats) is what mkfs -O quota's own hidden quota inode
# actually needs at mount time to be readable at all.
CONFIG_QUOTA=y
CONFIG_QFMT_V2=y

# Required to execve() any ELF binary at all, including init itself --
# allnoconfig ignores Kconfig "default y" statements (that's the whole
# point of allnoconfig), so this needs to be explicit even though it
# looks like it should be on by default.
CONFIG_BINFMT_ELF=y
CONFIG_ELF_CORE=y

# The same trap as BINFMT_ELF above, and it bit for real: without this
# the kernel does not understand "#!" at all, so execve() of any script
# returns ENOEXEC. That failure is close to silent, because the caller
# is almost always a shell -- and POSIX says a shell whose execve()
# returns ENOEXEC must run the file ITSELF. So every shell script kept
# working by pure coincidence (a shell interpreting a shell script is
# the right answer by accident), while every script with any other
# interpreter was quietly handed to bash.
#
# Found via diffutils, whose build runs the bundled help2man Perl
# script: with /usr/bin/perl present and working, `./help2man` still
# died with `line 27: syntax error near unexpected token '('` on
# `use Text::Tabs qw(expand);` -- bash's error, from bash reading a
# Perl program. Reproduced in isolation afterwards with a two-line
# #!/usr/bin/perl script, which is what turned "diffutils is broken"
# into "this kernel cannot run scripts".
#
# Nothing about this is specific to Perl: python, awk, sed -f wrappers,
# anything using #!/usr/bin/env, and any shell script with a shebang
# for a shell other than the caller's were all equally broken.
CONFIG_BINFMT_SCRIPT=y

# Namespaces container.c/mountns.c/ns_create.c already rely on.
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
# USER_NS: prerequisite for issue #29 / ADR-0179 phase 2 (CLONE_NEWUSER +
# id-mapped-mount flip). Without it CLONE_NEWUSER returns EINVAL on any
# kernel built from this file, regardless of the runtime environment --
# so this had to be explicit here before phase 2 could even be attempted
# on the real target (a Proxmox VM that owns this guest kernel). Enables
# CONFIG_USER_NS's own dependency chain (idmapped mounts over overlayfs/
# ext4, both already present above) automatically via olddefconfig.
CONFIG_USER_NS=y

# Core networking -- thincd's own socket()/bind()/listen() (AF_INET),
# and a prerequisite for VIRTIO_NET/NETDEVICES above.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y

# Not exercised by part 1's own pass bar, but cheap to build in now
# rather than a second kernel rebuild-and-reboot cycle soon after --
# the vswitch/routing phases (6-7) need these once containers actually
# run under thincd-as-PID-1.
CONFIG_BRIDGE=y
CONFIG_VLAN_8021Q=y

# VETH: found missing during a real live investigation on 192.168.15.95
# (found while building the first real DNS containers on this kernel) --
# genuinely absent from this file since its very first commit (confirmed
# via a full `git log -p` grep across the whole history, zero hits),
# meaning every one of this project's own real container-network
# attachments (src/container_net.c's rtnl_veth_create(), the *only*
# mechanism a container ever gets a network interface through) has
# always been dependent on a kernel primitive this fragment never
# actually enabled. Every prior "container networking works" test in
# this project's own history ran directly on this dev sandbox's own
# host kernel (which already has veth, like any normal distro kernel),
# never on a real box booted from a kernel built from this exact file
# -- so this gap was real but had simply never been exercised
# end-to-end before now. Confirmed live: `POST /v1/containers` with
# any `networks` attachment failed with a bare `Operation not
# supported` (ENOTSUP/EOPNOTSUPP, the kernel's own answer to `RTM_NEWLINK`
# for a link kind it has no driver for), even for containers on a
# bridge that itself already existed and worked fine (CONFIG_BRIDGE=y
# above is not sufficient on its own -- a bridge needs veth or a real
# NIC to actually attach anything to it).
CONFIG_VETH=y

# AMD GPU passthrough (Phase 14, ADR-0028/ADR-0029) -- daemon/src/device.c's
# "gpu" bus discovers /sys/class/drm nodes and /sys/class/kfd/kfd, none of
# which exist without these. FW_LOADER is explicit for the same reason
# BINFMT_ELF above is: allnoconfig ignores Kconfig "default y", so anything
# needed must be listed even if it would normally be on by default.
# HSA_AMD is the KFD/ROCm compute driver (creates /dev/kfd) -- without it
# this would only ever support display, not the compute workload this was
# actually built for. No SI/CIK (pre-GCN3 chip support).
CONFIG_FW_LOADER=y
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_AMDGPU=y
CONFIG_HSA_AMD=y

# Video console (closes a real gap this Phase-11-era config originally, and
# deliberately, deferred -- see the note this comment replaces): the loader
# entry already passes "console=tty0 console=ttyS0", but tty0 had nothing
# behind it, so only serial ever showed anything, on both Proxmox's own
# virtual display and real hardware. The modern, driver-agnostic path: ride
# the EFI GOP framebuffer UEFI firmware already sets up via a simple-
# framebuffer platform device (SYSFB_SIMPLEFB), driven by DRM's own
# "simpledrm" driver rather than the older, more limited FB_EFI fbdev-only
# path -- works without any GPU-specific driver, so it doesn't depend on
# amdgpu being bound to anything. DRM_FBDEV_EMULATION is what actually lets
# a DRM driver (simpledrm here) back a text console via FRAMEBUFFER_CONSOLE.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y

# Video console keyboard input (the above gave tty0 an output path only --
# confirmed directly against a real resolved .config that nothing could turn
# a keypress into anything the kernel sees): PS/2 (KEYBOARD_ATKBD selects
# SERIO/SERIO_LIBPS2/SERIO_I8042 itself -- covers Proxmox's typical emulated
# PS/2 keyboard) plus USB HID over xHCI (covers real hardware's USB-only
# keyboards for the eventual bare-metal migration). INPUT_KEYBOARD is a real
# menuconfig gate KEYBOARD_ATKBD's own Kconfig entry lives inside ("if
# INPUT_KEYBOARD") -- explicit here for the same allnoconfig-ignores-
# "default y" reason every other symbol in this file is. Serial (ttyS0)
# already works both ways without any of this -- a UART needs no separate
# input driver. USB_SUPPORT and HID_SUPPORT are two more menuconfig gates
# (drivers/usb/Kconfig, drivers/hid/Kconfig) wrapping their entire
# respective subsystems in "if" blocks -- confirmed the hard way, a first
# build attempt without them silently left USB/USB_PCI/USB_XHCI_HCD/
# USB_XHCI_PCI/HID/HID_GENERIC/USB_HID all unset despite being listed
# below, caught by this file's own required post-merge verification step
# rather than reaching a real boot with no keyboard support.
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# Part 3 (bare-metal-readiness plan): loadable module support, plus a
# curated set of common real-hardware drivers as =m rather than =y.
# Unlike the storage block above, none of these are ever needed to
# reach root or console input in this project's model (root's own
# controller and USB keyboard input are both already built directly
# into the kernel above, for that exact reason) -- they're loaded
# post-boot by thincd's own boot_init() via a real modprobe (Part 3's
# kmod recipe), the same "load only what a given real machine actually
# has" shape distro installers use, without hardcoding every possible
# NIC/USB-storage-controller combination as always-resident =y bloat.
CONFIG_MODULES=y
# Network: common real-hardware NICs (QEMU/VirtIO's own CONFIG_VIRTIO_NET
# above stays built-in, unaffected). BNX2 (Broadcom NetXtreme II)
# deliberately excluded -- unlike every driver here, it cannot function
# AT ALL without a real firmware blob loaded into the card first (a
# fully firmware-driven NIC, not graceful-degrade-without-it like R8169
# can be for many chip revisions), and staging real linux-firmware
# blobs for it is real, separate scope not done in this pass -- a known,
# honest gap, not silently dropped.
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_IXGBE=m
CONFIG_R8169=m
CONFIG_TIGON3=m
# USB: EHCI (older USB 2.0-only controllers -- XHCI above already
# covers USB 3.0 and its own backward-compat mode for USB 2.0/1.1
# devices on any remotely modern board; EHCI only matters for genuinely
# old hardware with no XHCI controller at all, never needed for the
# already-working console keyboard path) and mass storage (external
# USB drives -- never root, never needed at boot). CONFIG_SCSI itself
# is already =y above (the real-disk half of AHCI) -- this just adds
# the USB transport on top of it.
CONFIG_USB_EHCI_HCD=m
CONFIG_USB_STORAGE=m

# Swap (ADR-0069, daemon/src/swap.c) -- this kernel never had swap
# support built in before now, since nothing in this from-scratch OS
# had ever needed it. Confirmed the hard way, not by inspection: a
# real swapon(2) call against a real swap file on the actual target
# kernel returned "500 swap file creation or activation failed" (a
# bare ENOSYS from the kernel with no CONFIG_SWAP at all), even though
# the exact same code path had already been verified working in this
# dev sandbox -- which runs a normal Debian host kernel with swap
# already built in, so that verification could never have caught a
# missing kernel config option on thinC's own custom kernel. No
# further options are needed for a plain swap file with no compression
# or backing-device tiering. (That last sentence used to end "neither
# of which this project uses" -- zswap is used now, see below.)
CONFIG_SWAP=y

# zswap (issue #51, ADR-0196 -- docs/adr/0196-zswap-owned-by-the-daemon.md) -- compresses pages in RAM before they
# would otherwise be written to the real swap device, so memory
# pressure costs CPU instead of disk I/O. Not speculative: 192.168.15.95
# went fully unresponsive during a real -j6 gcc bootstrap that drove it
# into swap thrashing on a disk this box has already shown real
# fragility on (ADR-0178's two kernel Oopses in the page-cache/writeback
# path). zswap does not fix a disk-path bug; it reduces how often that
# path is entered at all.
#
# CONFIG_ZSWAP selects CRYPTO and ZSMALLOC itself (mm/Kconfig), so
# neither is listed here -- listing a select'ed symbol would be a
# second place for that dependency to be stated and to go stale.
#
# CONFIG_ZSWAP_DEFAULT_ON is deliberately NOT set. Whether zswap is on
# is a real, operator-visible setting owned by the daemon
# (GET/PUT /v1/system/zswap, daemon/src/zswap.c), and a kernel that
# also decided it at boot would be a second source of truth for one
# fact -- the kernel default stays off, and the daemon is the only
# thing that turns it on.
CONFIG_ZSWAP=y

# Three compressors compiled in, not one. The compressor is a runtime
# module parameter, so an operator can change it without a rebuild --
# but only among those actually built in, which makes "compiled in" the
# thing that decides whether that knob is real. LZO is the default (the
# kernel's own, and the fastest of the three: on a box whose failure
# mode was a CPU-saturated parallel compile, spending less CPU per page
# is the point). LZ4 and ZSTD are there for a workload that would
# rather trade CPU for a better ratio.
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_LZO=y
CONFIG_CRYPTO_LZO=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y

# inotify (task #747/#762): confirmed the hard way via a real
# container's own capture_output diagnostic, not by inspection -- a
# real, running glauth process reported "could not start
# config-watcher error=\"function not implemented\"" (ENOSYS from
# inotify_init()) at startup and silently fell back to a one-time
# config read, so thinC's own live LDAP user/group CRUD writes
# (ldap_write_config_file(), ADR-0109) never reached an already-running
# glauth instance -- only a fresh container start (which re-reads the
# file once at boot) ever picked up current data, exactly the kind of
# intermittent-looking symptom that made the real "listener mystery"
# investigation drag across multiple sessions before this kernel gap
# was ever isolated. glauth's own fsnotify watcher (`v2/glauth.go`'s
# startConfigWatcher(), active whenever the config sets
# `watchconfig = true`) is Linux inotify under the hood -- this
# kernel never enabled CONFIG_INOTIFY_USER at all, since nothing built
# before glauth ever needed live filesystem-change notification inside
# a container. `select FSNOTIFY` (fs/notify/inotify/Kconfig) is its
# only real Kconfig dependency -- olddefconfig resolves that
# automatically, nothing else needs listing here.
CONFIG_INOTIFY_USER=y

# seccomp (task #759): confirmed the hard way via capture_output, not
# by inspection -- a real jump box container's own sshd accepted the
# TCP connection and completed key exchange identification, but every
# single SSH client saw an immediate "Connection reset by peer" mid-
# handshake while sshd's own parent process stayed healthy and
# "running" throughout, exactly the kind of intermittent-looking
# symptom (a per-connection preauth child failing, not the daemon
# itself) that made this drag across sessions. captured_output showed
# the real cause directly: "ssh_sandbox_child: prctl(PR_SET_SECCOMP):
# Invalid argument [preauth]" -- OpenSSH's own privilege-separation
# preauth child unconditionally tries to install a seccomp-BPF filter
# as a hardening measure (Linux's `linux_seccomp_filter()` sandbox in
# openssh's own sandbox-seccomp-filter.c) and treats EINVAL as fatal,
# killing the connection. CONFIG_HAVE_ARCH_SECCOMP/_FILTER are both
# already =y (x86_64 always supports it), but this kernel's own
# allnoconfig starting point forces every overridable bool -- even a
# `def_bool y` one like CONFIG_SECCOMP itself -- to n unless this
# fragment says otherwise, the same class of gap CONFIG_INOTIFY_USER
# above and CONFIG_VETH before it both were.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

CONFIG_DEFAULT_HOSTNAME="thinc"
